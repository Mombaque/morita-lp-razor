@page "/checkout/{publicCheckoutId:guid}"
@model Morita.LP.Razor.Pages.CheckoutStatusModel
@{
    ViewData["Title"] = "Seu checkout | Morita Fight";
    ViewData["Robots"] = "noindex,nofollow";
    var statusLabel = Model.Checkout?.Status switch
    {
        "active" => "Aguardando pagamento",
        "cancelled" => "Cancelada",
        "expired" => "Expirada",
        "paymentpending" => "Pagamento pendente",
        "conversionpending" => "Conversão do pagamento em andamento",
        "refundpending" => "Estorno em andamento",
        "completed" => "Pedido concluído",
        "refunded" => "Pagamento estornado",
        _ => "Atualização da reserva"
    };
    var statusTone = statusLabel switch
    {
        "Pagamento pendente" => "payment-status-pending",
        "Pagamento cancelado" => "payment-status-cancelled",
        _ => ""
    };
}
<main class="checkout-shell checkout-status-page" data-checkout="status">
    @if (Model.AccountMessage is not null)
    {
        <p class="account-status" role="status">@Model.AccountMessage</p>
    }

    @if (Model.Checkout is null)
    {
        <div class="catalog-state catalog-unavailable" data-checkout="inaccessible" role="alert">
            <p class="checkout-kicker">Morita // Checkout</p>
            <h1>Reserva indisponível</h1>
            <p>@Model.Message</p>
            <a class="commerce-button commerce-button-secondary" href="/products">Voltar aos produtos</a>
        </div>
    }
    else
    {
        <header class="checkout-status-header">
            <p class="checkout-kicker">Morita // Checkout</p>
            <div class="checkout-status-heading">
                <h1>Seu checkout</h1>
                <div class="checkout-status-badge @statusTone" data-checkout-status="@Model.Checkout.Status">
                    <span class="checkout-status-dot" aria-hidden="true"></span>
                    <span>@statusLabel</span>
                </div>
            </div>
        </header>

        <div class="checkout-status-grid">
            <section class="checkout-status-card checkout-summary-card" aria-labelledby="reservation-summary">
                <div class="checkout-card-heading">
                    <div>
                        <p class="checkout-card-kicker">01 // Pedido</p>
                        <h2 id="reservation-summary">Resumo do pedido</h2>
                    </div>
                    <span class="checkout-card-index" aria-hidden="true">01</span>
                </div>

                <ul class="checkout-line-items">
                    @foreach (var line in Model.Checkout.Lines)
                    {
                        <li>
                            <div>
                                <strong>@line.Presentation</strong>
                                <span>@line.Quantity × @CurrencyPresentation.Symbol(Model.Checkout.Currency) @line.UnitPrice.ToString("0.00")</span>
                            </div>
                            <strong>@CurrencyPresentation.Symbol(Model.Checkout.Currency) @line.LineTotal.ToString("0.00")</strong>
                        </li>
                    }
                </ul>

                <dl class="checkout-totals">
                    <div>
                        <dt>Produtos</dt>
                        <dd>@CurrencyPresentation.Symbol(Model.Checkout.Currency) @Model.Checkout.MerchandiseTotal.ToString("0.00")</dd>
                    </div>
                    @if (Model.Checkout.FreightTotal > 0)
                    {
                        <div>
                            <dt>Frete</dt>
                            <dd>@CurrencyPresentation.Symbol(Model.Checkout.Currency) @Model.Checkout.FreightTotal.ToString("0.00")</dd>
                        </div>
                    }
                    <div class="checkout-total-row">
                        <dt>Total</dt>
                        <dd>@CurrencyPresentation.Symbol(Model.Checkout.Currency) @Model.Checkout.Total.ToString("0.00")</dd>
                    </div>
                </dl>

                <div class="checkout-expiry">
                    <span>Validade da reserva</span>
                    <time datetime="@Model.Checkout.ExpiresAt.ToString("O")">@Model.Checkout.ExpiresAt.ToLocalTime().ToString("g")</time>
                </div>
            </section>

            @if (Model.Checkout.FulfillmentMethod == "pickup" && Model.Checkout.Pickup is { } pickup)
            {
                <section class="checkout-status-card checkout-fulfillment-card" aria-labelledby="fulfillment-summary">
                    <div class="checkout-card-heading">
                        <div>
                            <p class="checkout-card-kicker">02 // Retirada</p>
                            <h2 id="fulfillment-summary">Retirada</h2>
                        </div>
                        <span class="checkout-card-index" aria-hidden="true">02</span>
                    </div>
                    <p class="checkout-fulfillment-primary">@pickup.DisplayName</p>
                    <address class="checkout-address">@pickup.Address.Street, @pickup.Address.Number<br>@pickup.Address.Neighborhood<br>@pickup.Address.City/@pickup.Address.State</address>
                    <p class="checkout-fulfillment-note">@pickup.Hours</p>
                    @if (!string.IsNullOrWhiteSpace(pickup.Instructions))
                    {
                        <p class="checkout-fulfillment-note">@pickup.Instructions</p>
                    }
                </section>
            }
            else if (Model.Checkout.Shipping is { } shipping)
            {
                <section class="checkout-status-card checkout-fulfillment-card" aria-labelledby="fulfillment-summary">
                    <div class="checkout-card-heading">
                        <div>
                            <p class="checkout-card-kicker">02 // Entrega</p>
                            <h2 id="fulfillment-summary">Entrega</h2>
                        </div>
                        <span class="checkout-card-index" aria-hidden="true">02</span>
                    </div>
                    <p class="checkout-fulfillment-primary">@shipping.ServiceName</p>
                    <p class="checkout-fulfillment-carrier">@shipping.CarrierName</p>
                    <p class="checkout-delivery-window"><span>Prazo estimado</span>@shipping.MinimumDeliveryDays a @shipping.MaximumDeliveryDays dias úteis</p>
                    <address class="checkout-address">@shipping.Address.Recipient<br>@shipping.Address.Street, @shipping.Address.Number @shipping.Address.Complement<br>@shipping.Address.Neighborhood<br>@shipping.Address.City/@shipping.Address.State · CEP @shipping.Address.PostalCode</address>
                </section>
            }
        </div>

        @if ((Model.Checkout.Status == "active" && Model.Payment is null) || Model.Payment is not null)
        {
            @await Html.PartialAsync("_CheckoutPaymentFlow", Model)
        }

        @if (Model.Checkout.Status == "expired")
        {
            <section class="checkout-next-step" aria-labelledby="restart-checkout-heading">
                <div>
                    <p class="checkout-card-kicker">03 // Próximo passo</p>
                    <h2 id="restart-checkout-heading">Refazer checkout</h2>
                    @if (Model.HasCurrentCart)
                    {
                        <p>Seu carrinho atual será substituído somente se você confirmar. Caso contrário, continue com o carrinho atual.</p>
                    }
                    else
                    {
                        <p>Restaure os itens, confira a disponibilidade e gere um novo pagamento.</p>
                    }
                </div>
                <div class="checkout-status-actions">
                    <form method="post" asp-page-handler="RestoreCheckout">
                        <button class="commerce-button commerce-button-primary" type="submit">Refazer com estes itens</button>
                    </form>
                    @if (Model.HasCurrentCart)
                    {
                        <a class="commerce-button commerce-button-secondary" href="/checkout">Continuar com carrinho atual</a>
                    }
                </div>
            </section>
        }

    }
</main>
@section Scripts { <script type="module" src="~/js/payment.js" asp-append-version="true"></script> }
