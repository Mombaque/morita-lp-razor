@page "/checkout/{publicCheckoutId:guid}"
@model Morita.LP.Razor.Pages.CheckoutStatusModel
@{
    ViewData["Title"] = "Sua reserva | Morita Fight";
    ViewData["Robots"] = "noindex,nofollow";
}
<main class="checkout-shell" data-checkout="status">
    @if (Model.Checkout is null)
    {
        <div class="catalog-state catalog-unavailable" data-checkout="inaccessible" role="alert"><h1>Reserva indisponível</h1><p>@Model.Message</p><a class="button" href="/products">Voltar aos produtos</a></div>
    }
    else
    {
        <h1>Sua reserva</h1>
        <p data-checkout="status">Status: <strong>@(Model.Checkout.Status switch { "active" => "Aguardando pagamento", "cancelled" => "Cancelada", "expired" => "Expirada", "paymentpending" => "Pagamento pendente", "conversionpending" => "Conversão do pagamento em andamento", "refundpending" => "Estorno em andamento", "completed" => "Pedido concluído", "refunded" => "Pagamento estornado", _ => "Atualização da reserva" })</strong></p>
        @if (Model.Message is not null) { <p class="validation-error" role="alert">@Model.Message</p> }
        <section aria-labelledby="reservation-summary"><h2 id="reservation-summary">Resumo confirmado</h2><p>Total: <strong>@Model.Checkout.Currency @Model.Checkout.Total.ToString("0.00")</strong></p><p>Validade da reserva: <time datetime="@Model.Checkout.ExpiresAt.ToString("O")">@Model.Checkout.ExpiresAt.ToLocalTime().ToString("g")</time></p><ul>@foreach (var line in Model.Checkout.Lines) { <li>@line.Presentation — @line.Quantity × @Model.Checkout.Currency @line.UnitPrice.ToString("0.00")</li> }</ul></section>
        <section aria-labelledby="pickup-summary"><h2 id="pickup-summary">Retirada</h2><p><strong>@Model.Checkout.Pickup.DisplayName</strong></p><p>@Model.Checkout.Pickup.Address.Street, @Model.Checkout.Pickup.Address.Number - @Model.Checkout.Pickup.Address.Neighborhood, @Model.Checkout.Pickup.Address.City/@Model.Checkout.Pickup.Address.State</p><p>@Model.Checkout.Pickup.Hours</p>@if (!string.IsNullOrWhiteSpace(Model.Checkout.Pickup.Instructions)) { <p>@Model.Checkout.Pickup.Instructions</p> }</section>
        @if (Model.Checkout.Status == "active" && Model.Payment is null)
        {
            @if (Model.PaymentState is PaymentLoadState.NotFound or PaymentLoadState.Success)
            { <form method="post" asp-page-handler="PayPix"><button class="button primary-cta" type="submit">Pagar com PIX</button></form> }
        }
        @if (Model.Payment is { } payment)
        {
                var terminal = payment.Status is "converted" or "failed" or "cancelled" or "expired" or "refundpending" or "refunded";
                var canCancelPayment = (Model.Checkout.Status is "active" or "paymentpending" or "conversionpending") && (payment.Status is "pending" or "processing" or "approved" or "conversionpending");
                <section class="pix-corner-card" aria-labelledby="pix-heading" data-payment-status="@payment.Status"><h2 id="pix-heading">PIX <span class="payment-state">@(payment.Status switch { "pending" => "Aguardando pagamento", "processing" or "conversionpending" => "Pagamento em análise", "approved" => "Pagamento aprovado; finalizando pedido", "failed" => "Pagamento não aprovado", "cancelled" => "Pagamento cancelado", "expired" => "PIX expirado", "refundpending" => "Estorno em andamento", "refunded" => "Pagamento estornado", "converted" => "Pagamento aprovado", _ => "Atualização do pagamento" })</span></h2>
                    @if (!terminal && (payment.Status is "pending" or "processing" or "approved" or "conversionpending") && !string.IsNullOrWhiteSpace(payment.QrCodePngDataUri) && !string.IsNullOrWhiteSpace(payment.PixCopyPaste)) { <ol><li>Abra o app do seu banco.</li><li>Escaneie o QR Code ou copie o código PIX.</li><li>Confirme o valor e aguarde a aprovação.</li></ol><img class="pix-qr" src="@payment.QrCodePngDataUri" alt="QR Code para pagar @payment.Currency @payment.Amount.ToString("0.00")" /><label for="pix-copy">Código PIX</label><textarea id="pix-copy" readonly rows="4">@payment.PixCopyPaste</textarea><button class="button" type="button" data-copy-pix>Copiar código PIX</button><p>Expira em <time datetime="@payment.ExpiresAt.ToString("O")">@payment.ExpiresAt.ToLocalTime().ToString("g")</time>.</p> }
                    @if (canCancelPayment) { <form method="post" asp-page-handler="Cancel"><button class="button" type="submit">Cancelar pagamento</button></form> }
                </section>
        }
        @if (Model.Checkout.Status == "active" && Model.Payment is null)
        {
            @if (Model.PaymentState is PaymentLoadState.NotFound or PaymentLoadState.Success)
            {
                <form method="post" asp-page-handler="Cancel"><button class="button" type="submit">Cancelar reserva</button></form>
            }
        }
    }
</main>
@section Scripts { <script type="module" src="~/js/payment.js" asp-append-version="true"></script> }
