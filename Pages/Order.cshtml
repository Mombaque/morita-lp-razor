@page "/order/{publicOrderNumber}"
@model Morita.LP.Razor.Pages.OrderModel
@{ ViewData["Title"] = "Seu pedido | Morita Fight"; ViewData["Robots"] = "noindex,nofollow"; }
<main class="checkout-shell" data-order="page">
@if (Model.Order is null) { <div class="catalog-state catalog-unavailable" role="alert"><h1>Pedido indisponível</h1><p>@Model.Message</p><a class="button" href="/products">Voltar aos produtos</a></div> }
else { var order = Model.Order; <h1>Pedido confirmado</h1><p class="order-number">Número do pedido: <strong>@order.PublicOrderNumber</strong></p><p>Pagamento: <strong>@(order.PaymentStatus switch { "converted" => "Aprovado", "processing" or "approved" or "conversionpending" => "Em análise", "failed" => "Não aprovado", "cancelled" => "Cancelado", "expired" => "Expirado", "refundpending" => "Estorno em andamento", "refunded" => "Estornado", _ => "Pendente" })</strong></p><section aria-labelledby="order-summary"><h2 id="order-summary">Resumo</h2><ul>@foreach (var line in order.Lines) { <li><strong>@line.Presentation</strong> — @line.Quantity × @order.Currency @line.UnitPrice.ToString("0.00")</li> }</ul><p>Total: <strong>@order.Currency @order.Amount.ToString("0.00")</strong></p><p>Pedido criado em <time datetime="@order.CreatedAt.ToString("O")">@order.CreatedAt.ToLocalTime().ToString("g")</time>.</p></section><section aria-labelledby="pickup-order"><h2 id="pickup-order">Retirada</h2><p><strong>@order.PickupDisplayName</strong></p><p>@order.PickupAddress.Street, @order.PickupAddress.Number - @order.PickupAddress.Neighborhood, @order.PickupAddress.City/@order.PickupAddress.State</p><p>@order.PickupHours</p>@if (!string.IsNullOrWhiteSpace(order.PickupInstructions)) { <p>@order.PickupInstructions</p> }<p>Retirada: <strong>@(order.FulfillmentStatus switch { "pending" => "Aguardando preparação", "preparingpickup" => "Em preparação", "readyforpickup" => "Pronto para retirada", "pickedup" => "Retirado", _ => "Em atualização" })</strong>@if (order.FulfillmentUpdatedAt is { } updated) { <span> — atualizado em <time datetime="@updated.ToString("O")">@updated.ToLocalTime().ToString("g")</time></span> }</p></section> }
</main>
