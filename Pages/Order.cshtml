@page "/order/{publicOrderNumber}"
@model Morita.LP.Razor.Pages.OrderModel
@{
    ViewData["Title"] = "Seu pedido | Morita Fight";
    ViewData["Robots"] = "noindex,nofollow";
}

<main class="checkout-shell" data-order="page">
    @if (Model.ClaimMessage is not null)
    {
        <p class="validation-error" role="alert">@Model.ClaimMessage</p>
    }
    @if (Model.Order is null)
    {
        <div class="catalog-state catalog-unavailable" role="alert">
            <h1>Pedido indisponível</h1>
            <p>@Model.Message</p>
            <a class="button" href="/products">Voltar aos produtos</a>
        </div>
    }
    else
    {
        <header class="checkout-heading">
            <p class="fight-label">Pedido Morita</p>
            <h1>Pedido confirmado</h1>
            <p class="order-number">Número do pedido: <strong>@Model.Order.PublicOrderNumber</strong></p>
        </header>
        <partial name="_AccountOrderDetail" model="Model.Order" />
        @if (Model.CanClaim)
        {
            <form method="post" asp-page-handler="Claim">
                <button class="commerce-button commerce-button-secondary" type="submit">Vincular este pedido à minha conta</button>
            </form>
            <p>O vínculo é manual e usa o acesso deste pedido neste dispositivo.</p>
        }
        else if (!Model.SignedIn)
        {
            <p class="account-status">Quer guardar este pedido no seu histórico?</p>
            <a class="commerce-button commerce-button-primary" href="/conta?mode=signin&amp;returnUrl=%2Forder%2F@Model.PublicOrderNumber">Entrar ou criar conta</a>
        }
    }
</main>
