@page "/order/{publicOrderNumber}"
@model Morita.LP.Razor.Pages.OrderModel
@{ ViewData["Title"] = "Seu pedido | Morita Fight"; ViewData["Robots"] = "noindex,nofollow"; }
<main class="checkout-shell" data-order="page">
@if (Model.ClaimMessage is not null) { <p class="validation-error" role="alert">@Model.ClaimMessage</p> }
@if (Model.Order is null) { <div class="catalog-state catalog-unavailable" role="alert"><h1>Pedido indisponível</h1><p>@Model.Message</p><a class="button" href="/products">Voltar aos produtos</a></div> }
else { var order = Model.Order; <h1>Pedido confirmado</h1><p class="order-number">Número do pedido: <strong>@order.PublicOrderNumber</strong></p><p>Pagamento: <strong>@(order.PaymentStatus switch { "converted" => "Aprovado", "processing" or "approved" or "conversionpending" => "Em análise", "failed" => "Não aprovado", "cancelled" => "Cancelado", "expired" => "Expirado", "refundpending" => "Estorno em andamento", "refunded" => "Estornado", _ => "Pendente" })</strong></p><section aria-labelledby="order-summary"><h2 id="order-summary">Resumo</h2><ul>@foreach (var line in order.Lines) { <li><strong>@line.Presentation</strong> — @line.Quantity × @order.Currency @line.UnitPrice.ToString("0.00")</li> }</ul>@if(order.Shipping is { } freight){<p>Frete: <strong>@order.Currency @freight.Price.ToString("0.00")</strong></p>}<p>Total: <strong>@order.Currency @order.Amount.ToString("0.00")</strong></p><p>Pedido criado em <time datetime="@order.CreatedAt.ToString("O")">@order.CreatedAt.ToLocalTime().ToString("g")</time>.</p></section>
@if(order.FulfillmentMethod == "pickup" && order.PickupAddress is { } pickupAddress){<section aria-labelledby="pickup-order"><h2 id="pickup-order">Retirada</h2><p><strong>@order.PickupDisplayName</strong></p><p>@pickupAddress.Street, @pickupAddress.Number - @pickupAddress.Neighborhood, @pickupAddress.City/@pickupAddress.State</p><p>@order.PickupHours</p>@if (!string.IsNullOrWhiteSpace(order.PickupInstructions)) { <p>@order.PickupInstructions</p> }<p>Retirada: <strong>@(order.FulfillmentStatus switch { "pending" => "Aguardando preparação", "preparingpickup" => "Em preparação", "readyforpickup" => "Pronto para retirada", "pickedup" => "Retirado", "cancelled" => "Cancelado", _ => "Em atualização" })</strong>@if (order.FulfillmentUpdatedAt is { } updated) { <span> — atualizado em <time datetime="@updated.ToString("O")">@updated.ToLocalTime().ToString("g")</time></span> }</p></section>}
else if(order.Shipping is { } shipping){<section aria-labelledby="shipping-order"><h2 id="shipping-order">Entrega</h2><p><strong>@shipping.ServiceName · @shipping.CarrierName</strong></p><p>Prazo estimado: @shipping.MinimumDeliveryDays a @shipping.MaximumDeliveryDays dias úteis.</p><p>@shipping.Address.Recipient<br>@shipping.Address.Street, @shipping.Address.Number @shipping.Address.Complement<br>@shipping.Address.Neighborhood · @shipping.Address.City/@shipping.Address.State · CEP @shipping.Address.PostalCode</p>@if(order.Shipment is { } shipment){<p>Envio: <strong>@(shipment.Status switch { "awaitinglabel" or "labelpurchasepending" => "Preparando etiqueta", "labelpurchased" => "Etiqueta emitida", "intransit" => "Em trânsito", "delivered" => "Entregue", "cancellationpending" => "Cancelamento em andamento", "cancelled" => "Cancelado", "exception" => "Transportadora verificando ocorrência", _ => "Em preparação" })</strong></p>@if(!string.IsNullOrWhiteSpace(shipment.TrackingCode)){<p>Código de rastreio: <strong>@shipment.TrackingCode</strong></p>}<p>Atualizado em <time datetime="@shipment.UpdatedAt.ToString("O")">@shipment.UpdatedAt.ToLocalTime().ToString("g")</time>.</p>}</section>} }
@if (Model.Order is not null && Model.CanClaim) { <form method="post" asp-page-handler="Claim"><button class="commerce-button commerce-button-secondary">Vincular este pedido à minha conta</button></form><p>O vínculo é manual e usa o acesso deste pedido neste dispositivo.</p> }
</main>
