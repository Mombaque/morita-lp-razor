@page "/products"
@model ProductsModel
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@using System.Text.Json
@{
    var canonical = (Configuration["CanonicalBaseUrl"] ?? "https://moritafight.com.br/").TrimEnd('/') + "/products";
    var resultLabel = Model.Catalog.TotalCount == 1 ? "produto" : "produtos";
    ViewData["Title"] = "Catálogo completo | Morita Fight";
    ViewData["Description"] = "Kimonos, luvas, rashguards, shorts e acessórios para artes marciais com preço e estoque confirmados.";
    ViewData["Canonical"] = canonical;
    ViewData["Robots"] = Model.HasFilters ? "noindex,follow" : "index,follow,max-snippet:-1,max-image-preview:large,max-video-preview:-1";
    ViewData["BodyClass"] = "commerce-page catalog-page";
    var jsonLd = JsonSerializer.Serialize(new Dictionary<string, object?>
    {
        ["@context"] = "https://schema.org",
        ["@type"] = "ItemList",
        ["itemListElement"] = Model.Catalog.Items.Select((p, i) => new Dictionary<string, object?>
        {
            ["@type"] = "ListItem",
            ["position"] = i + 1,
            ["url"] = $"{canonical}/{Uri.EscapeDataString(p.Slug ?? "")}",
            ["name"] = p.Nome
        })
    });
}

@section Header {
    <script type="application/ld+json">@Html.Raw(jsonLd)</script>
}

<main class="storefront-shell">
    <header class="storefront-header">
        <p class="fight-label">Catálogo Morita / Fight supply</p>
        <h1>Escolha seu<br><span>equipamento.</span></h1>
        <p>Filtre por treino, categoria, público, tamanho e faixa de preço.</p>
    </header>

    <form id="catalog-filter-form" class="catalog-filter-form" method="get" action="/products">
        <div class="catalog-toolbar" aria-label="Controles do catálogo">
            <button class="catalog-filter-trigger" type="button" data-filter-open aria-controls="catalog-filter-drawer" aria-expanded="false">
                <span class="catalog-filter-trigger-icon" aria-hidden="true">☷</span>
                <span>Filtros</span>
                @if (Model.ActiveFilterCount > 0)
                {
                    <span class="catalog-filter-count">@Model.ActiveFilterCount</span>
                }
            </button>

            <label class="catalog-sort-control">
                <span>Ordenar</span>
                <select name="sort" data-catalog-sort>
                    <option value="featured" selected="@(Model.Sort == "featured" ? "selected" : null)">Destaques</option>
                    <option value="relevance" disabled="@(string.IsNullOrWhiteSpace(Model.Search) ? "disabled" : null)" selected="@(Model.Sort == "relevance" ? "selected" : null)">Relevância</option>
                    <option value="name-asc" selected="@(Model.Sort == "name-asc" ? "selected" : null)">Nome</option>
                    <option value="price-asc" selected="@(Model.Sort == "price-asc" ? "selected" : null)">Menor preço</option>
                    <option value="price-desc" selected="@(Model.Sort == "price-desc" ? "selected" : null)">Maior preço</option>
                </select>
            </label>

            <p class="catalog-result-count" aria-live="polite">@Model.Catalog.TotalCount @resultLabel</p>
        </div>

        @if (Model.ActiveFilterChips.Count > 0)
        {
            <div class="active-filter-chips" aria-label="Filtros ativos">
                @foreach (var chip in Model.ActiveFilterChips)
                {
                    <a class="active-filter-chip" href="@Model.QueryWithout(chip.Key)" aria-label="Remover filtro @chip.Label">
                        <span>@chip.Label</span><span aria-hidden="true">×</span>
                    </a>
                }
            </div>
        }

        <div class="catalog-filter-backdrop" data-filter-backdrop hidden></div>
        <aside id="catalog-filter-drawer" class="catalog-filter-drawer" data-filter-drawer role="dialog" aria-modal="true" aria-hidden="true" aria-labelledby="catalog-filter-title" inert tabindex="-1">
            <div class="catalog-filter-drawer-header">
                <div>
                    <p class="fight-label">Refinar catálogo</p>
                    <h2 id="catalog-filter-title">Filtros</h2>
                    <p>Encontre o equipamento certo para o seu treino.</p>
                </div>
                <button class="catalog-filter-close" type="button" data-filter-close aria-label="Fechar filtros">×</button>
            </div>

            <div class="catalog-filter-drawer-body">
                <label>Buscar <input name="search" value="@Model.Search" maxlength="100" autocomplete="off" placeholder="Nome, slug ou categoria"></label>
                <label>Modalidade <select name="modalityId"><option value="" selected="@(Model.ModalityId is null ? "selected" : null)">Todas</option>@foreach (var f in Model.Filters.Modalities){<option value="@f.Id" selected="@(Model.ModalityId == f.Id ? "selected" : null)">@f.Label</option>}</select></label>
                <label>Categoria <select name="categoryId"><option value="" selected="@(Model.CategoryId is null ? "selected" : null)">Todas</option>@foreach (var f in Model.Filters.Categories){<option value="@f.Id" selected="@(Model.CategoryId == f.Id ? "selected" : null)">@f.Label</option>}</select></label>
                <label>Marca <select name="brandId"><option value="" selected="@(Model.BrandId is null ? "selected" : null)">Todas</option>@foreach (var f in Model.Filters.Brands){<option value="@f.Id" selected="@(Model.BrandId == f.Id ? "selected" : null)">@f.Label</option>}</select></label>
                <label>Tamanho <select name="sizeId"><option value="" selected="@(Model.SizeId is null ? "selected" : null)">Todos</option>@foreach (var f in Model.Filters.Sizes){<option value="@f.Id" selected="@(Model.SizeId == f.Id ? "selected" : null)">@f.Label</option>}</select></label>
                <label>Cor <select name="colorId"><option value="" selected="@(Model.ColorId is null ? "selected" : null)">Todas</option>@foreach (var f in Model.Filters.Colors){<option value="@f.Id" selected="@(Model.ColorId == f.Id ? "selected" : null)">@f.Label</option>}</select></label>
                <label>Disponibilidade <select name="available"><option value="" selected="@(Model.Available is null ? "selected" : null)">Todas</option><option value="true" selected="@(Model.Available == true ? "selected" : null)">Disponível</option><option value="false" selected="@(Model.Available == false ? "selected" : null)">Indisponível</option></select></label>
                <label>Público <select name="audience"><option value="" selected="@(Model.Audience is null ? "selected" : null)">Todos</option><option value="adult" selected="@(Model.Audience == PublicCatalogAudience.Adult ? "selected" : null)">Adulto</option><option value="kids" selected="@(Model.Audience == PublicCatalogAudience.Kids ? "selected" : null)">Infantil</option><option value="all" selected="@(Model.Audience == PublicCatalogAudience.All ? "selected" : null)">Todas as idades</option></select></label>
                <div class="catalog-price-fields">
                    <label>Preço mínimo <input type="number" name="minimumPrice" value="@(Model.MinimumPrice?.ToString(System.Globalization.CultureInfo.InvariantCulture))" min="0" step="0.01" inputmode="decimal"></label>
                    <label>Preço máximo <input type="number" name="maximumPrice" value="@(Model.MaximumPrice?.ToString(System.Globalization.CultureInfo.InvariantCulture))" min="0" step="0.01" inputmode="decimal"></label>
                </div>
            </div>

            <div class="catalog-filter-drawer-actions">
                <a class="clear-catalog-filters" href="/products">Limpar</a>
                <button class="button filter-submit" type="submit">Ver @Model.Catalog.TotalCount @resultLabel</button>
            </div>
        </aside>
    </form>

    <section class="products storefront-products" aria-live="polite">
        @if (Model.Catalog.State == CatalogLoadState.Unavailable)
        {
            <div class="catalog-state catalog-unavailable"><h2>Catálogo temporariamente indisponível</h2><p>Tente novamente em instantes.</p></div>
        }
        else if (Model.Catalog.State == CatalogLoadState.Empty)
        {
            <div class="catalog-state catalog-empty"><h2>Nenhum produto encontrado</h2><p>Tente remover um filtro.</p></div>
        }
        else
        {
            @for (var i = 0; i < Model.Catalog.Items.Count; i++)
            {
                <partial name="_ProductCard" model="@(new ProductCardViewModel(Model.Catalog.Items[i], "products", i))" />
            }
        }
    </section>

    @if (Model.Catalog.TotalPages > 1)
    {
        <nav class="pagination" aria-label="Paginação">
            @if (Model.CurrentPage > 1)
            {
                <a href="@Model.Query(Model.CurrentPage - 1)">Anterior</a>
            }
            <span>Página @Model.CurrentPage de @Model.Catalog.TotalPages</span>
            @if (Model.CurrentPage < Model.Catalog.TotalPages)
            {
                <a href="@Model.Query(Model.CurrentPage + 1)">Próxima</a>
            }
        </nav>
    }
</main>

@section Scripts {
    <script type="module" src="~/js/catalog-filters.js" asp-append-version="true"></script>
}
