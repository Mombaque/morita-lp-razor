@page "/conta"
@model Morita.LP.Razor.Pages.AccountModel
@{
    ViewData["Title"] = "Minha conta | Morita Fight";
    ViewData["BodyClass"] = "commerce-page account-page";
}

<main class="account-shell">
    <header class="checkout-heading">
        <p class="fight-label">Registro de treino / conta</p>
        <h1>Minha conta</h1>
        <p>Seu histórico e seus endereços, sem senha.</p>
    </header>

    @if (Model.Error is not null)
    {
        <p class="validation-error" role="alert">@Model.Error</p>
    }
    @if (Model.Message is not null)
    {
        <p class="account-status" role="status">@Model.Message</p>
    }

    @if (!Model.SignedIn)
    {
        <section class="account-panel" aria-labelledby="account-access-heading">
            <h2 id="account-access-heading">@(Model.Mode == "create" ? "Criar conta" : "Entrar")</h2>
            <p>
                Use um código de uso único enviado ao seu e-mail. Na primeira confirmação, o acesso também pode criar sua conta;
                nunca informamos se um e-mail já está cadastrado.
            </p>
            <div asp-validation-summary="All" class="validation-error" role="alert"></div>
            <form method="post" asp-page-handler="RequestCode">
                <input type="hidden" asp-for="Mode">
                <input type="hidden" asp-for="ReturnUrl">
                <label asp-for="EmailForm.Email">E-mail</label>
                <input asp-for="EmailForm.Email" type="email" autocomplete="email">
                <span asp-validation-for="EmailForm.Email" class="validation-error"></span>
                <button class="commerce-button commerce-button-primary" type="submit">Enviar código</button>
            </form>
            <p>
                <a href="/conta?mode=@(Model.Mode == "create" ? "signin" : "create")&returnUrl=@Uri.EscapeDataString(Model.ReturnUrl ?? "")">
                    @(Model.Mode == "create" ? "Já tenho uma conta: entrar" : "Ainda não tenho conta: criar acesso")
                </a>
            </p>
        </section>

        @if (Model.ChallengeIssued)
        {
            <section class="account-panel" aria-labelledby="verify-heading">
                <h2 id="verify-heading">Confirmar código</h2>
                <p>O código expira em @Model.ChallengeExpiresAt?.ToLocalTime().ToString("t").</p>
                <div asp-validation-summary="All" class="validation-error" role="alert"></div>
                <form method="post" asp-page-handler="VerifyCode">
                    <input type="hidden" asp-for="Verification.ChallengeId">
                    <input type="hidden" asp-for="ChallengeId">
                    <input type="hidden" asp-for="PrivacyPolicyVersion">
                    <input type="hidden" asp-for="ChallengeKind">
                    <input type="hidden" asp-for="Mode">
                    <input type="hidden" asp-for="ReturnUrl">
                    <fieldset>
                        <legend>Código enviado por e-mail</legend>
                        <label asp-for="Verification.Code">Código de seis números</label>
                        <input asp-for="Verification.Code" inputmode="numeric" autocomplete="one-time-code">
                        <span asp-validation-for="Verification.Code" class="validation-error"></span>
                    </fieldset>
                    <label class="account-check" asp-for="AcceptedPrivacyPolicy">
                        <input asp-for="AcceptedPrivacyPolicy">
                        <span>
                            Aceito a política de privacidade
                            @if (Model.PrivacyPolicyUrl is not null)
                            {
                                <text>(<a href="@Model.PrivacyPolicyUrl">ler a política</a>)</text>
                            }
                            . Para um e-mail novo, isso cria a conta.
                        </span>
                    </label>
                    <span asp-validation-for="AcceptedPrivacyPolicy" class="validation-error"></span>
                    <button class="commerce-button commerce-button-primary" type="submit">Confirmar acesso</button>
                </form>
            </section>
        }
    }
    else
    {
        <nav class="account-tabs" aria-label="Seções da conta">
            <a href="#perfil">Perfil</a>
            <a href="#enderecos">Endereços</a>
            <a href="#pedidos">Pedidos</a>
            <a href="#seguranca">Segurança</a>
        </nav>

        <section id="perfil" class="account-panel" aria-labelledby="profile-heading">
            <h2 id="profile-heading">Perfil</h2>
            <p class="account-email">@Model.Profile!.Email</p>
            <div asp-validation-summary="All" class="validation-error" role="alert"></div>
            <form method="post" asp-page-handler="SaveProfile">
                <label asp-for="ProfileForm.Name">Nome</label>
                <input asp-for="ProfileForm.Name" autocomplete="name">
                <span asp-validation-for="ProfileForm.Name" class="validation-error"></span>
                <label asp-for="ProfileForm.Phone">Telefone</label>
                <input asp-for="ProfileForm.Phone" autocomplete="tel">
                <span asp-validation-for="ProfileForm.Phone" class="validation-error"></span>
                <button class="commerce-button commerce-button-primary" type="submit">Salvar perfil</button>
            </form>
        </section>

        <section id="enderecos" class="account-panel" aria-labelledby="addresses-heading">
            <h2 id="addresses-heading">Endereços</h2>
            <p>Você pode guardar até 10 endereços.</p>
            @if (Model.Addresses.Count == 0)
            {
                <p>Nenhum endereço salvo ainda.</p>
            }
            @foreach (var address in Model.Addresses)
            {
                <article class="address-card" aria-labelledby="address-@address.PublicAddressId">
                    <h3 id="address-@address.PublicAddressId">
                        @address.Label
                        @if (address.IsDefault)
                        {
                            <span aria-label="endereço padrão">Padrão</span>
                        }
                    </h3>
                    <p>
                        @address.Recipient<br>
                        @address.Street, @address.Number @address.Complement<br>
                        @address.Neighborhood · @address.City/@address.State<br>
                        CEP @address.PostalCode
                    </p>
                    <a class="commerce-button commerce-button-secondary" href="/conta?handler=EditAddress&amp;id=@address.PublicAddressId#enderecos">Editar endereço</a>
                    @if (!address.IsDefault)
                    {
                        <form method="post" asp-page-handler="SetDefaultAddress" class="inline-form">
                            <button name="id" value="@address.PublicAddressId" class="commerce-button commerce-button-secondary" type="submit">Definir como padrão</button>
                        </form>
                    }
                    <form method="post" asp-page-handler="DeleteAddress" class="inline-form">
                        <button name="id" value="@address.PublicAddressId" class="commerce-button commerce-button-danger" type="submit" aria-label="Excluir o endereço @address.Label" onclick="return confirm('Excluir o endereço @address.Label?');">Excluir endereço</button>
                    </form>
                </article>
            }
            @if (Model.CanAddAddress || Model.IsEditingAddress)
            {
                <div class="address-form-container">
                    <h3>@(Model.IsEditingAddress ? "Editar endereço" : "Adicionar endereço")</h3>
                    <partial name="_AddressForm" model="Model" />
                </div>
            }
            else
            {
                <p class="account-status">Você já atingiu o limite de 10 endereços. Edite ou exclua um endereço para adicionar outro.</p>
            }
        </section>

        <section id="pedidos" class="account-panel" aria-labelledby="orders-heading">
            <h2 id="orders-heading">Pedidos</h2>
            @if (Model.OrdersError is not null)
            {
                <p class="validation-error" role="alert">@Model.OrdersError</p>
            }
            else if (Model.Orders.Items.Count == 0)
            {
                <p>Ainda não há pedidos.</p>
            }
            else
            {
                <ol class="order-ledger">
                    @foreach (var order in Model.Orders.Items)
                    {
                        <li>
                            <a href="/conta?publicOrderNumber=@Uri.EscapeDataString(order.PublicOrderNumber)#pedidos">
                                @if (!string.IsNullOrWhiteSpace(order.RepresentativeProductImageUrl))
                                {
                                    <img src="@order.RepresentativeProductImageUrl" alt="" loading="lazy">
                                }
                                <span>
                                    <strong>@order.PublicOrderNumber</strong>
                                    <span>@(order.RepresentativeProductPresentation ?? "Pedido Morita")</span>
                                    <span>@AccountPresentation.FulfillmentMethod(order.FulfillmentMethod) · @AccountPresentation.FulfillmentStatus(order.FulfillmentStatus)</span>
                                </span>
                                <em>@AccountPresentation.PaymentStatus(order.PaymentStatus)<br>@order.Currency @order.Amount.ToString("N2")<br><time datetime="@order.CreatedAt.ToString("O")">@order.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</time></em>
                            </a>
                        </li>
                    }
                </ol>
                @if (Model.Orders.TotalPages > 1)
                {
                    <nav class="pagination" aria-label="Paginação de pedidos">
                        @if (Model.Orders.Page > 1)
                        {
                            <a href="/conta?CurrentPage=@(Model.Orders.Page - 1)#pedidos">Anterior</a>
                        }
                        <span>Página @Model.Orders.Page de @Model.Orders.TotalPages</span>
                        @if (Model.Orders.Page < Model.Orders.TotalPages)
                        {
                            <a href="/conta?CurrentPage=@(Model.Orders.Page + 1)#pedidos">Próxima</a>
                        }
                    </nav>
                }
            }
        </section>

        @if (Model.SelectedOrder is not null)
        {
            <partial name="_AccountOrderDetail" model="Model.SelectedOrder" />
        }
        else if (Model.PublicOrderNumber is not null)
        {
            <p class="validation-error" role="alert">Este pedido não foi encontrado ou está temporariamente indisponível.</p>
        }

        <section id="seguranca" class="account-panel" aria-labelledby="security-heading">
            <h2 id="security-heading">Segurança</h2>
            <p>Acesso por código, sem senha.</p>
            <form method="post" asp-page-handler="Logout">
                <button class="commerce-button commerce-button-secondary" type="submit">Sair desta sessão</button>
            </form>
            <form method="post" asp-page-handler="Logout">
                <input type="hidden" name="all" value="true">
                <button class="commerce-button commerce-button-secondary" type="submit">Sair de todos os dispositivos</button>
            </form>
            <details class="account-danger" open="@(Model.ClosureChallengeIssued || Model.ModelState.ContainsKey("ConfirmClosure") ? "open" : null)">
                <summary>Encerrar minha conta</summary>
                <p>O encerramento é permanente. Por obrigação legal, alguns registros poderão ser mantidos pelo período exigido, mas sua conta não ficará disponível para uso.</p>
                <form method="post" asp-page-handler="RequestClosureCode">
                    <input type="hidden" asp-for="ChallengeKind">
                    <label class="account-check" asp-for="ConfirmClosure">
                        <input asp-for="ConfirmClosure">
                        <span>Entendo que o encerramento é permanente.</span>
                    </label>
                    <span asp-validation-for="ConfirmClosure" class="validation-error"></span>
                    <button class="commerce-button commerce-button-danger" type="submit">Enviar código para encerrar a conta</button>
                </form>
                @if (Model.ClosureChallengeIssued)
                {
                    <form method="post" asp-page-handler="VerifyClosureCode">
                        <input type="hidden" asp-for="Verification.ChallengeId">
                        <input type="hidden" asp-for="ChallengeId">
                        <input type="hidden" asp-for="ChallengeKind">
                        <input type="hidden" asp-for="ChallengeExpiresAt">
                        <label asp-for="Verification.Code">Código de encerramento</label>
                        <input asp-for="Verification.Code" inputmode="numeric" autocomplete="one-time-code">
                        <span asp-validation-for="Verification.Code" class="validation-error"></span>
                        <p>Este código expira em @Model.ChallengeExpiresAt?.ToLocalTime().ToString("t").</p>
                        <button class="commerce-button commerce-button-danger" type="submit">Encerrar conta permanentemente</button>
                    </form>
                }
            </details>
        </section>
        <partial name="_AccountEmailChange" model="Model" />
    }
</main>
