@page "/conta"
@model Morita.LP.Razor.Pages.AccountModel
@{
    ViewData["Title"] = "Minha conta | Morita Fight";
    ViewData["BodyClass"] = "commerce-page account-page";
}

<main class="account-shell">
    <header class="checkout-heading">
        <p class="fight-label">Registro de treino / conta</p>
        <h1>Minha conta</h1>
        <p>Seu histórico, seus endereços e um acesso protegido por senha.</p>
    </header>

    @if (Model.AccountErrors.Count > 0)
    {
        <aside id="account-errors" class="account-error-toast" role="alert" aria-live="assertive" data-account-error>
            <div class="account-error-toast-heading">
                <strong>Não foi possível concluir</strong>
                <button type="button" data-dismiss-account-error aria-label="Fechar mensagens de erro">×</button>
            </div>
            <ul>
                @foreach (var error in Model.AccountErrors)
                {
                    <li>@error</li>
                }
            </ul>
        </aside>
    }
    @if (Model.Message is not null)
    {
        <p class="account-status" role="status">@Model.Message</p>
    }

    @if (!Model.SignedIn)
    {
        <section class="account-panel" aria-labelledby="account-access-heading">
            @if (Model.PasswordChallengeIssued)
            {
                <h2 id="account-access-heading">Definir nova senha</h2>
                <p>Informe o código enviado por e-mail e escolha uma nova senha.</p>
                <form method="post" asp-page-handler="ResetPassword">
                    <input type="hidden" asp-for="ChallengeId"><input type="hidden" asp-for="ChallengeExpiresAt"><input type="hidden" asp-for="ChallengeKind"><input type="hidden" asp-for="PrivacyPolicyVersion"><input type="hidden" asp-for="ReturnUrl">
                    <label asp-for="Verification.Code">Código enviado por e-mail</label>
                    <input asp-for="Verification.Code" inputmode="numeric" autocomplete="one-time-code">
                    <span asp-validation-for="Verification.Code" class="validation-error"></span>
                    <label asp-for="PasswordForm.Password">Nova senha</label>
                    <input asp-for="PasswordForm.Password" type="password" autocomplete="new-password">
                    <span asp-validation-for="PasswordForm.Password" class="validation-error"></span>
                    <label asp-for="PasswordForm.Confirmation">Confirme a nova senha</label>
                    <input asp-for="PasswordForm.Confirmation" type="password" autocomplete="new-password">
                    <span asp-validation-for="PasswordForm.Confirmation" class="validation-error"></span>
                    <button class="commerce-button commerce-button-primary" type="submit">Salvar nova senha</button>
                </form>
            }
            else if (Model.EmailVerificationChallengeIssued)
            {
                <h2 id="account-access-heading">Confirmar e-mail</h2>
                <p>O código expira em @Model.ChallengeExpiresAt?.ToLocalTime().ToString("t").</p>
                <form method="post" asp-page-handler="VerifyEmail">
                    <input type="hidden" asp-for="ChallengeId"><input type="hidden" asp-for="ChallengeExpiresAt"><input type="hidden" asp-for="ChallengeKind"><input type="hidden" asp-for="PrivacyPolicyVersion"><input type="hidden" asp-for="ReturnUrl">
                    <label asp-for="Verification.Code">Código enviado por e-mail</label>
                    <input asp-for="Verification.Code" inputmode="numeric" autocomplete="one-time-code">
                    <span asp-validation-for="Verification.Code" class="validation-error"></span>
                    <button class="commerce-button commerce-button-primary" type="submit">Confirmar e-mail</button>
                </form>
            }
            else if (Model.Mode == "signin")
            {
                <h2 id="account-access-heading">Entrar</h2>
                <p>Use o e-mail e a senha da sua conta.</p>
                <form method="post" asp-page-handler="Login">
                    <input type="hidden" asp-for="ReturnUrl">
                    <label asp-for="Login.Email">E-mail</label><input asp-for="Login.Email" type="email" autocomplete="email"><span asp-validation-for="Login.Email" class="validation-error"></span>
                    <label asp-for="Login.Password">Senha</label><input asp-for="Login.Password" type="password" autocomplete="current-password"><span asp-validation-for="Login.Password" class="validation-error"></span>
                    <button class="commerce-button commerce-button-primary" type="submit">Entrar</button>
                </form>
                <p><a href="/conta?mode=forgot&amp;returnUrl=@Uri.EscapeDataString(Model.ReturnUrl ?? "")">Esqueci minha senha</a></p>
                <p>Ainda não tem uma conta? <a href="/conta?mode=create&amp;returnUrl=@Uri.EscapeDataString(Model.ReturnUrl ?? "")">Criar conta</a></p>
            }
            else if (Model.Mode == "forgot")
            {
                <h2 id="account-access-heading">Redefinir senha</h2>
                <p>Enviaremos um código ao e-mail informado, se houver uma conta cadastrada.</p>
                <form method="post" asp-page-handler="RequestPasswordCode">
                    <input type="hidden" asp-for="ReturnUrl">
                    <label asp-for="EmailForm.Email">E-mail</label><input asp-for="EmailForm.Email" type="email" autocomplete="email"><span asp-validation-for="EmailForm.Email" class="validation-error"></span>
                    <button class="commerce-button commerce-button-primary" type="submit">Enviar código</button>
                </form>
                <p><a href="/conta?mode=signin&amp;returnUrl=@Uri.EscapeDataString(Model.ReturnUrl ?? "")">Voltar para entrar</a></p>
            }
            else
            {
                <h2 id="account-access-heading">Criar conta</h2>
                <p>Crie sua conta com nome, telefone, e-mail e senha. Enviaremos um código apenas para confirmar o e-mail.</p>
                <form method="post" asp-page-handler="Register">
                    <input type="hidden" asp-for="ReturnUrl">
                    <label asp-for="Registration.Name">Nome</label><input asp-for="Registration.Name" autocomplete="name"><span asp-validation-for="Registration.Name" class="validation-error"></span>
                    <label asp-for="Registration.Phone">Telefone</label><input asp-for="Registration.Phone" autocomplete="tel"><span asp-validation-for="Registration.Phone" class="validation-error"></span>
                    <label asp-for="Registration.Email">E-mail</label><input asp-for="Registration.Email" type="email" autocomplete="email"><span asp-validation-for="Registration.Email" class="validation-error"></span>
                    <label asp-for="Registration.Password">Senha</label><input asp-for="Registration.Password" type="password" autocomplete="new-password"><span asp-validation-for="Registration.Password" class="validation-error"></span>
                    <label asp-for="Registration.Confirmation">Confirme a senha</label><input asp-for="Registration.Confirmation" type="password" autocomplete="new-password"><span asp-validation-for="Registration.Confirmation" class="validation-error"></span>
                    <label class="account-check" asp-for="Registration.AcceptedPrivacyPolicy"><input asp-for="Registration.AcceptedPrivacyPolicy"><span>Aceito a política de privacidade @if (Model.PrivacyPolicyUrl is not null) { <text>(<a href="@Model.PrivacyPolicyUrl">ler a política</a>)</text> }.</span></label>
                    <span asp-validation-for="Registration.AcceptedPrivacyPolicy" class="validation-error"></span>
                    <button class="commerce-button commerce-button-primary" type="submit">Criar conta</button>
                </form>
                <p>Já tem uma conta? <a href="/conta?mode=signin&amp;returnUrl=@Uri.EscapeDataString(Model.ReturnUrl ?? "")">Entrar</a></p>
            }
        </section>
    }
    else
    {
        <div class="account-layout">
            <aside class="account-sidebar">
                <p class="account-sidebar-label">Área do cliente</p>
                <nav class="account-tabs" aria-label="Seções da conta">
                    <a href="#perfil"><span class="account-tab-number">01</span><span>Perfil</span></a>
                    <a href="#enderecos"><span class="account-tab-number">02</span><span>Endereços</span></a>
                    <a href="#pedidos"><span class="account-tab-number">03</span><span>Pedidos</span></a>
                    <a href="#seguranca"><span class="account-tab-number">04</span><span>Segurança</span></a>
                </nav>
            </aside>

            <div class="account-content">

        <section id="perfil" class="account-panel" aria-labelledby="profile-heading">
            <h2 id="profile-heading">Perfil</h2>
            <p class="account-email">@Model.Profile!.Email</p>
            <form method="post" asp-page-handler="SaveProfile">
                <label asp-for="ProfileForm.Name">Nome</label>
                <input asp-for="ProfileForm.Name" autocomplete="name">
                <span asp-validation-for="ProfileForm.Name" class="validation-error"></span>
                <label asp-for="ProfileForm.Phone">Telefone</label>
                <input asp-for="ProfileForm.Phone" autocomplete="tel">
                <span asp-validation-for="ProfileForm.Phone" class="validation-error"></span>
                <button class="commerce-button commerce-button-primary" type="submit">Salvar perfil</button>
            </form>
        </section>

        <section id="enderecos" class="account-panel" aria-labelledby="addresses-heading">
            <h2 id="addresses-heading">Endereços</h2>
            <p>Você pode guardar até 10 endereços.</p>
            @if (Model.Addresses.Count == 0)
            {
                <p>Nenhum endereço salvo ainda.</p>
            }
            @foreach (var address in Model.Addresses)
            {
                <article class="address-card" aria-labelledby="address-@address.PublicAddressId">
                    <h3 id="address-@address.PublicAddressId">
                        @address.Label
                        @if (address.IsDefault)
                        {
                            <span aria-label="endereço padrão">Padrão</span>
                        }
                    </h3>
                    <p>
                        @address.Recipient<br>
                        @address.Street, @address.Number @address.Complement<br>
                        @address.Neighborhood · @address.City/@address.State<br>
                        CEP @address.PostalCode
                    </p>
                    <div class="address-actions">
                        <a class="commerce-button commerce-button-secondary" href="/conta?handler=EditAddress&amp;id=@address.PublicAddressId#enderecos">Editar endereço</a>
                        @if (!address.IsDefault)
                        {
                            <form method="post" asp-page-handler="SetDefaultAddress">
                                <button name="id" value="@address.PublicAddressId" class="commerce-button commerce-button-secondary" type="submit">Definir como padrão</button>
                            </form>
                        }
                        <form method="post" asp-page-handler="DeleteAddress">
                            <button name="id" value="@address.PublicAddressId" class="commerce-button commerce-button-danger" type="submit" aria-label="Excluir o endereço @address.Label" data-confirm-delete-address="@address.Label">Excluir endereço</button>
                        </form>
                    </div>
                </article>
            }
            @if (Model.CanAddAddress || Model.IsEditingAddress)
            {
                <div class="address-form-container">
                    <h3>@(Model.IsEditingAddress ? "Editar endereço" : "Adicionar endereço")</h3>
                    <partial name="_AddressForm" model="Model" />
                </div>
            }
            else
            {
                <p class="account-status">Você já atingiu o limite de 10 endereços. Edite ou exclua um endereço para adicionar outro.</p>
            }
        </section>

        <section id="pedidos" class="account-panel" aria-labelledby="orders-heading">
            <h2 id="orders-heading">Pedidos</h2>
            @if (Model.OrdersError is not null)
            {
                <p class="validation-error" role="alert">@Model.OrdersError</p>
            }
            @if (Model.Orders.PendingCheckouts.Count > 0)
            {
                <h3>Pagamentos pendentes</h3>
                <p class="account-status pending-checkout-note">Há um checkout aguardando pagamento. Retome-o para concluir o pedido.</p>
                <ol class="order-ledger pending-checkout-ledger">
                    @foreach (var pending in Model.Orders.PendingCheckouts)
                    {
                        <li>
                            <a href="/checkout/@pending.PublicCheckoutId.ToString("D")">
                                @if (!string.IsNullOrWhiteSpace(pending.RepresentativeProductImageUrl))
                                {
                                    <img src="@pending.RepresentativeProductImageUrl" alt="" loading="lazy">
                                }
                                <span>
                                    <strong>Pagamento pendente</strong>
                                    <span>@(pending.RepresentativeProductPresentation ?? "Checkout Morita")</span>
                                    <span>@AccountPresentation.FulfillmentMethod(pending.FulfillmentMethod) · Retome o pagamento</span>
                                </span>
                                <em>@AccountPresentation.PaymentStatus(pending.Status)<br>@pending.Currency @pending.Amount.ToString("N2")<br><time datetime="@pending.CreatedAt.ToString("O")">@pending.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</time></em>
                            </a>
                        </li>
                    }
                </ol>
            }
            @if (Model.Orders.Items.Count == 0 && Model.Orders.PendingCheckouts.Count == 0)
            {
                <p>Ainda não há pedidos.</p>
            }
            else if (Model.Orders.Items.Count > 0)
            {
                @if (Model.Orders.PendingCheckouts.Count > 0)
                {
                    <h3>Histórico de pedidos</h3>
                }
                <ol class="order-ledger">
                    @foreach (var order in Model.Orders.Items)
                    {
                        <li>
                            <a href="/conta?publicOrderNumber=@Uri.EscapeDataString(order.PublicOrderNumber)#pedidos">
                                @if (!string.IsNullOrWhiteSpace(order.RepresentativeProductImageUrl))
                                {
                                    <img src="@order.RepresentativeProductImageUrl" alt="" loading="lazy">
                                }
                                <span>
                                    <strong>@order.PublicOrderNumber</strong>
                                    <span>@(order.RepresentativeProductPresentation ?? "Pedido Morita")</span>
                                    <span>@AccountPresentation.FulfillmentMethod(order.FulfillmentMethod) · @AccountPresentation.FulfillmentStatus(order.FulfillmentStatus)</span>
                                </span>
                                <em>@AccountPresentation.PaymentStatus(order.PaymentStatus)<br>@order.Currency @order.Amount.ToString("N2")<br><time datetime="@order.CreatedAt.ToString("O")">@order.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</time></em>
                            </a>
                        </li>
                    }
                </ol>
                @if (Model.Orders.TotalPages > 1)
                {
                    <nav class="pagination" aria-label="Paginação de pedidos">
                        @if (Model.Orders.Page > 1)
                        {
                            <a href="/conta?CurrentPage=@(Model.Orders.Page - 1)#pedidos">Anterior</a>
                        }
                        <span>Página @Model.Orders.Page de @Model.Orders.TotalPages</span>
                        @if (Model.Orders.Page < Model.Orders.TotalPages)
                        {
                            <a href="/conta?CurrentPage=@(Model.Orders.Page + 1)#pedidos">Próxima</a>
                        }
                    </nav>
                }
            }
        </section>

        @if (Model.SelectedOrder is not null)
        {
            <partial name="_AccountOrderDetail" model="Model.SelectedOrder" />
        }
        else if (Model.PublicOrderNumber is not null)
        {
            <p class="validation-error" role="alert">Este pedido não foi encontrado ou está temporariamente indisponível.</p>
        }

        <section id="seguranca" class="account-panel" aria-labelledby="security-heading">
            <h2 id="security-heading">Segurança</h2>
            <p>Use sua senha para entrar. O código por e-mail fica reservado para confirmar o primeiro acesso e alterar a senha.</p>
            <form method="post" asp-page-handler="Logout" data-account-reset-scroll>
                <button class="commerce-button commerce-button-secondary" type="submit">Sair desta sessão</button>
            </form>
            <form method="post" asp-page-handler="Logout" data-account-reset-scroll>
                <input type="hidden" name="all" value="true">
                <button class="commerce-button commerce-button-secondary" type="submit">Sair de todos os dispositivos</button>
            </form>
            @if (Model.PasswordChallengeIssued)
            {
                <form method="post" asp-page-handler="ResetPassword" class="account-security-form">
                    <input type="hidden" asp-for="ChallengeId"><input type="hidden" asp-for="ChallengeExpiresAt"><input type="hidden" asp-for="ChallengeKind">
                    <label asp-for="Verification.Code">Código enviado por e-mail</label><input asp-for="Verification.Code" inputmode="numeric" autocomplete="one-time-code"><span asp-validation-for="Verification.Code" class="validation-error"></span>
                    <label asp-for="PasswordForm.Password">Nova senha</label><input asp-for="PasswordForm.Password" type="password" autocomplete="new-password"><span asp-validation-for="PasswordForm.Password" class="validation-error"></span>
                    <label asp-for="PasswordForm.Confirmation">Confirme a nova senha</label><input asp-for="PasswordForm.Confirmation" type="password" autocomplete="new-password"><span asp-validation-for="PasswordForm.Confirmation" class="validation-error"></span>
                    <button class="commerce-button commerce-button-secondary" type="submit">Salvar nova senha</button>
                </form>
            }
            else
            {
                <form method="post" asp-page-handler="RequestPasswordCode" class="account-security-form">
                    <input type="hidden" asp-for="EmailForm.Email" value="@Model.Profile!.Email">
                    <button class="commerce-button commerce-button-secondary" type="submit">@(Model.Profile.HasPassword ? "Alterar minha senha" : "Definir minha senha")</button>
                </form>
            }
            <details class="account-danger" open="@(Model.ModelState.ContainsKey("ConfirmClosure") || Model.ModelState.ContainsKey("CurrentPassword") ? "open" : null)">
                <summary>Encerrar minha conta</summary>
                <p>O encerramento é permanente. Por obrigação legal, alguns registros poderão ser mantidos pelo período exigido, mas sua conta não ficará disponível para uso.</p>
                <form method="post" asp-page-handler="Close">
                    <label class="account-check" asp-for="ConfirmClosure">
                        <input asp-for="ConfirmClosure">
                        <span>Entendo que o encerramento é permanente.</span>
                    </label>
                    <span asp-validation-for="ConfirmClosure" class="validation-error"></span>
                    <label asp-for="CurrentPassword">Senha atual</label>
                    <input asp-for="CurrentPassword" type="password" autocomplete="current-password">
                    <span asp-validation-for="CurrentPassword" class="validation-error"></span>
                    <button class="commerce-button commerce-button-danger" type="submit">Encerrar conta permanentemente</button>
                </form>
            </details>
        </section>
            </div>
        </div>
    }
</main>

@section Scripts {
    <script src="~/js/account.js" asp-append-version="true"></script>
}
