@page
@model ErrorModel
@{
    ViewData["Title"] = "Algo deu errado | Morita";
    ViewData["Robots"] = "noindex,nofollow";
    ViewData["BodyClass"] = "commerce-page legal-page";
}

<main class="legal-main" data-error-page="500">
    <p class="fight-label">Erro</p>
    <h1>Algo deu errado</h1>
    <p>Não conseguimos carregar esta página agora. Tente de novo em alguns instantes. Se estiver no meio de uma compra, seus itens continuam no carrinho.</p>
    <p><a class="commerce-button commerce-button-primary" href="/">Voltar para a loja</a> <a class="commerce-button commerce-button-secondary" href="@LegalPageModel.WhatsAppUrl" target="_blank" rel="noopener noreferrer">Falar no WhatsApp</a></p>
    @if (Model.ShowRequestId) { <p class="legal-updated">Código do erro: <code>@Model.RequestId</code></p> }
</main>
