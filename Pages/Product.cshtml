@page "/products/{slug}"
@model ProductModel
@section Header { @if(Model.Product is not null){ <script type="application/ld+json">@Html.Raw(Model.ProductJsonLd)</script><script type="application/ld+json">@Html.Raw(Model.BreadcrumbJsonLd)</script> } }
@section Scripts { @if(Model.Product is not null){ <script src="~/js/product-detail.js" asp-append-version="true"></script> } }
@{ var p=Model.Product; var priceLabel=p?.FormattedPrice??"Consulte"; if(p is null){var currentSlug=RouteData.Values["slug"]?.ToString()??"produto";ViewData["Title"]="Produto temporariamente indisponível | Morita Fight";ViewData["Description"]="O produto solicitado está temporariamente indisponível.";ViewData["Canonical"]=$"{Model.BaseUrl}/products/{Uri.EscapeDataString(currentSlug)}";ViewData["Robots"]="noindex,follow";ViewData["OgImage"]=null;}else{var canonical=$"{Model.BaseUrl}/products/{Uri.EscapeDataString(p.Slug??"")}";ViewData["Title"]=$"{p.Nome} | Morita Fight";ViewData["Description"]=p.Descricao;ViewData["Canonical"]=canonical;ViewData["OgImage"]=p.Imagens.FirstOrDefault();ViewData["Robots"]="index,follow";} }
@if(p is null){<main class="detail-shell"><div class="catalog-state catalog-unavailable"><h1>Produto temporariamente indisponível</h1><p>Tente novamente em instantes.</p><a href="/products">Voltar ao catálogo</a></div></main>}
@if(p is not null){
@if(!ViewData.ModelState.IsValid){<div class="validation-error" role="alert">@foreach(var error in ViewData.ModelState.Values.SelectMany(v=>v.Errors)){<p>@error.ErrorMessage</p>}</div>}
<main class="detail-shell" data-product-slug="@p.Slug"><a class="back-link" href="/products">← Voltar ao catálogo</a><div class="detail-layout">
<section class="detail-gallery" aria-label="Imagens de @p.Nome"><div class="detail-main-image">@if(p.Imagens.Count>0){<img id="detail-image" src="@p.Imagens[0]" alt="@p.Nome">}else{<span>Imagem indisponível</span>}</div><div class="detail-thumbs">@for(var i=0;i<p.Imagens.Count;i++){<button type="button" class="detail-thumb @(i==0?"selected":"")" data-image="@p.Imagens[i]" aria-label="Ver imagem @(i+1)"><img src="@p.Imagens[i]" alt=""></button>}</div></section>
<section class="detail-copy"><p class="taxonomy">@(p.Modality?.Label??"Morita") / @(p.Category?.Label??"Equipamento") / @(p.Brand?.Label??"")</p><h1>@p.Nome</h1><partial name="_ProductPrice" model="priceLabel"/><p class="availability-text">@(p.Availability=="available"?"Disponível para consulta":"Produto temporariamente indisponível")</p><p>@p.Descricao</p>@if(p.Details.Count>0){<div class="detail-specs"><h2>Ficha técnica</h2><ul>@foreach(var detail in p.Details){<li>@detail</li>}</ul></div>}
<form class="offer-boundary" method="get" action="/products/@Uri.EscapeDataString(p.Slug??"")" data-offer-form><fieldset><legend>Escolha uma oferta</legend><p>Escolha a combinação exata de cor e tamanho.</p>@foreach(var o in p.Variants.SelectMany(v=>v.Offers)){var label=$"{o.ColorLabel??"Cor única"} / {o.SizeLabel??"Tamanho único"}";var unavailable=o.Availability!="available"; <label class="offer-choice"><input type="radio" name="publicOfferId" value="@o.PublicOfferId" data-offer-id="@o.PublicOfferId" data-price="@o.UnitPrice" data-currency="@o.Currency" data-availability="@o.Availability" checked="@(Model.SelectedOfferId==o.PublicOfferId?"checked":null)" disabled="@(unavailable?"disabled":null)" required><span>@label</span>@if(unavailable){<small>Indisponível</small>}</label>}</fieldset><label class="quantity-label">Quantidade <input type="number" name="quantity" min="1" max="10" value="@Model.Quantity" aria-describedby="quantity-help"></label><p id="quantity-help">Escolha de 1 a 10 unidades.</p><p class="live-offer" aria-live="polite">@(Model.SelectedOffer is null?"Selecione uma oferta para ver preço e disponibilidade.":$"Oferta selecionada: {Model.SelectedOffer.ColorLabel??"Cor única"} / {Model.SelectedOffer.SizeLabel??"Tamanho único"}.")</p><button class="button primary-cta" type="submit">Confirmar seleção</button></form>
@if(Model.SelectionConfirmed){<div class="confirmed-selection" role="status"><p>Seleção confirmada para @Model.Quantity unidade(s).</p><form method="post" asp-page-handler="Add" class="cart-add-form"><input type="hidden" name="publicOfferId" value="@Model.SelectedOfferId"><input type="hidden" name="quantity" value="@Model.Quantity"><button class="button primary-cta" type="submit" data-cart="add">Adicionar ao carrinho</button></form><button class="button" type="button" data-request-open data-track-event="customer_product_request_open" data-track-category="product" data-track-selected-category="@p.Nome">Continuar com atendimento</button><a class="button whatsapp" href="@Model.WhatsAppUrl" target="_blank" rel="noopener noreferrer">Falar pelo WhatsApp</a></div>}
<noscript><p>Confirme a seleção acima para habilitar o atendimento.</p></noscript></section></div>
@if(Model.Related.State==CatalogLoadState.Success){<section class="related-products"><h2>Produtos relacionados</h2><div class="products">@for(var i=0;i<Model.Related.Products.Count;i++){<partial name="_ProductCard" model="@(new ProductCardViewModel(Model.Related.Products[i],"related",i))" />}</div></section>}else if(Model.Related.State==CatalogLoadState.Empty){<p class="related-state">Nenhum produto relacionado no momento.</p>}else if(Model.Related.State==CatalogLoadState.Unavailable){<p class="related-state">Produtos relacionados temporariamente indisponíveis.</p>}
</main>}
