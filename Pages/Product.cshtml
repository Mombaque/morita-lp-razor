@page "/products/{slug}"
@model ProductModel
@inject Microsoft.Extensions.Options.IOptions<Morita.LP.Razor.Configuration.StorefrontOptions> StorefrontOptions
@section Header { @if (Model.Product is not null) { <script type="application/ld+json">@Html.Raw(Model.ProductJsonLd)</script><script type="application/ld+json">@Html.Raw(Model.BreadcrumbJsonLd)</script> } }
@section Scripts { @if (Model.Product is not null) { <partial name="_AnalyticsEvent" model="AnalyticsEvents.ViewItem(Model.Product)" /><script src="~/js/product-detail.js" asp-append-version="true"></script> } }
@{
    var p = Model.Product;
    string VariantKey(ProductVariant variant, int index) => variant.ColorId?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? $"variant-{index}";
    string ColorValue(string? colorHex) => System.Text.RegularExpressions.Regex.IsMatch(colorHex ?? "", "^#[0-9a-fA-F]{6}$") ? colorHex! : "#68716d";
    var selectedOfferIsAvailable = Model.SelectedOffer is not null && string.Equals(Model.SelectedOffer.Availability, "available", StringComparison.OrdinalIgnoreCase);
    var selectedVariantIndex = p is null || !selectedOfferIsAvailable ? -1 : p.Variants.FindIndex(variant => variant.Offers.Any(offer => offer.PublicOfferId == Model.SelectedOffer!.PublicOfferId));
    var selectedVariantKey = selectedVariantIndex >= 0 ? VariantKey(p!.Variants[selectedVariantIndex], selectedVariantIndex) : null;
    var galleryItems = p is null
        ? new List<(string Image, string? VariantKey)>()
        : p.Variants.SelectMany((variant, index) => variant.Images.Select(image => (Image: image, VariantKey: (string?)VariantKey(variant, index)))).DistinctBy(item => item.Image).ToList();
    if (selectedVariantIndex > 0)
        galleryItems = galleryItems.OrderByDescending(item => item.VariantKey == selectedVariantKey).ToList();
    if (galleryItems.Count == 0 && p is not null)
        galleryItems = p.Imagens.Select(image => (Image: image, VariantKey: (string?)null)).ToList();
    var currentSlug = RouteData.Values["slug"]?.ToString() ?? "produto";
    ViewData["BodyClass"] = "commerce-page product-page";
    var priceLabel = p?.FormattedPrice ?? "Consulte";
    if (selectedOfferIsAvailable && Model.SelectedOffer?.UnitPrice is decimal selectedPrice && p is not null)
        priceLabel = CurrencyPresentation.Format(selectedPrice, p.Currency ?? Model.SelectedOffer.Currency);
    if (p is null) {
        ViewData["Title"] = "Produto temporariamente indisponível | Morita Fight";
        ViewData["Description"] = "O produto solicitado está temporariamente indisponível.";
        ViewData["Canonical"] = $"{Model.BaseUrl}/products/{Uri.EscapeDataString(currentSlug)}";
        ViewData["Robots"] = "noindex,follow";
        ViewData["OgImage"] = null;
    } else {
        var canonical = $"{Model.BaseUrl}/products/{Uri.EscapeDataString(p.Slug ?? "")}";
        ViewData["Title"] = $"{p.Nome} | Morita Fight";
        ViewData["Description"] = p.Descricao;
        ViewData["Canonical"] = canonical;
        ViewData["OgImage"] = p.Imagens.FirstOrDefault() is { } ogImage ? Model.AbsoluteUrl(ogImage) : null;
        ViewData["OgType"] = "product";
        ViewData["OgTitle"] = $"{p.Nome} | Morita Fight";
        ViewData["OgDescription"] = p.Descricao;
        ViewData["Robots"] = "index,follow";
    }
}
@if (p is null) {
    <main class="detail-shell"><div class="catalog-state catalog-unavailable"><h1>Produto temporariamente indisponível</h1><p>Tente novamente em instantes.</p><a href="/products">Voltar ao catálogo</a></div></main>
}
@if (p is not null) {
    var offerError = string.Join(" ", ViewData.ModelState.Values.SelectMany(value => value.Errors).Select(error => error.ErrorMessage).Where(message => !string.IsNullOrWhiteSpace(message)));
    <main class="detail-shell" data-product-slug="@p.Slug" data-selected-variant-key="@selectedVariantKey">
        <a class="back-link" href="/products">← Voltar ao catálogo</a>
        <div class="detail-layout">
            <section class="detail-gallery" aria-label="Imagens de @p.Nome">
                <div class="detail-main-image" data-gallery>
                    @if (galleryItems.Count > 0) {
                        @if (galleryItems.Count > 1) { <button type="button" class="detail-gallery-control detail-gallery-previous" data-gallery-prev aria-label="Imagem anterior"><span aria-hidden="true">‹</span></button> }
                        <button type="button" class="detail-zoom-trigger" data-lightbox-open aria-label="Ampliar imagem" aria-haspopup="dialog"><img id="detail-image" src="@(galleryItems[0].Image)" alt="@p.Nome"></button>
                        @if (galleryItems.Count > 1) { <button type="button" class="detail-gallery-control detail-gallery-next" data-gallery-next aria-label="Próxima imagem"><span aria-hidden="true">›</span></button> }
                    } else { <span>Imagem indisponível</span> }
                </div>
                <div class="detail-thumbs">
                    @for (var i = 0; i < galleryItems.Count; i++) {
                        <button type="button" class="detail-thumb @(i == 0 ? "selected" : "")" data-image="@galleryItems[i].Image" data-variant-key="@galleryItems[i].VariantKey" aria-label="Ver imagem @(i + 1)" aria-pressed="@(i == 0 ? "true" : "false")"><img src="@galleryItems[i].Image" alt=""></button>
                    }
                </div>
                @if (galleryItems.Count > 0) {
                    <dialog class="image-lightbox" data-lightbox aria-label="Imagens de @p.Nome">
                        <button type="button" class="image-lightbox-close" data-lightbox-close aria-label="Fechar">×</button>
                        <div class="image-lightbox-stage" data-lightbox-stage>
                            <img src="@(galleryItems[0].Image)" alt="@p.Nome" data-lightbox-image draggable="false">
                        </div>
                        @if (galleryItems.Count > 1) {
                            <button type="button" class="detail-gallery-control detail-gallery-previous image-lightbox-control" data-lightbox-prev aria-label="Imagem anterior"><span aria-hidden="true">‹</span></button>
                            <button type="button" class="detail-gallery-control detail-gallery-next image-lightbox-control" data-lightbox-next aria-label="Próxima imagem"><span aria-hidden="true">›</span></button>
                        }
                        <div class="image-lightbox-footer">
                            <p class="image-lightbox-counter" data-lightbox-counter aria-live="polite"></p>
                            <div class="detail-thumbs image-lightbox-thumbs" data-lightbox-thumbs></div>
                        </div>
                    </dialog>
                }
            </section>
            <section class="detail-copy">
                <p class="taxonomy">@string.Join(" / ", new[] { p.Modality?.Label ?? "Morita", p.Category?.Label, p.Brand?.Label }.Where(label => !string.IsNullOrWhiteSpace(label)))</p>
                <h1>@p.Nome</h1>
                <div data-detail-price><partial name="_ProductPrice" model="priceLabel" /></div>
                <p class="availability-text">@(p.Availability == "available" ? "Em estoque" : "Produto temporariamente indisponível")</p>
                <p>@p.Descricao</p>
                @if (p.Details.Count > 0) { <div class="detail-specs"><h2>Ficha técnica</h2><ul>@foreach (var detail in p.Details) { <li>@detail</li> }</ul></div> }
                @if (p.SizeGuide is { } sizeGuide) {
                    <details class="size-guide" data-size-guide>
                        <summary>Guia de medidas</summary>
                        @if (sizeGuide.Title is not null) { <h2>@sizeGuide.Title</h2> }
                        <div class="size-guide-scroll">
                            <table>
                                <thead><tr>@foreach (var column in sizeGuide.Columns) { <th scope="col">@column</th> }</tr></thead>
                                <tbody>@foreach (var row in sizeGuide.Rows) { <tr>@for (var cell = 0; cell < row.Count; cell++) { if (cell == 0) { <th scope="row">@row[cell]</th> } else { <td>@row[cell]</td> } }</tr> }</tbody>
                            </table>
                        </div>
                        @if (sizeGuide.Note is not null) { <p class="size-guide-note">@sizeGuide.Note</p> }
                    </details>
                }
                <form class="offer-boundary" method="post" asp-page-handler="Add" data-offer-form novalidate>
                    <fieldset aria-describedby="offer-validation-message">
                        <legend>Escolha uma oferta</legend>
                        <p>Escolha a combinação exata de cor e tamanho.</p>
                        <div class="detail-variant-matrix">
                            @for (var variantIndex = 0; variantIndex < p.Variants.Count; variantIndex++) {
                                var variant = p.Variants[variantIndex];
                                var key = VariantKey(variant, variantIndex);
                                var colorLabel = string.IsNullOrWhiteSpace(variant.ColorLabel) ? "Cor única" : variant.ColorLabel;
                                <div class="detail-variant-row" data-variant-key="@key">
                                    <div class="detail-variant-heading"><span class="product-variant-swatch" style="background-color: @ColorValue(variant.ColorHex)" aria-hidden="true"></span><span>@colorLabel</span></div>
                                    <div class="detail-variant-sizes" aria-label="Tamanhos @colorLabel">
                                        @foreach (var offer in variant.Offers) {
                                            var sizeLabel = string.IsNullOrWhiteSpace(offer.SizeLabel) ? "Tamanho único" : offer.SizeLabel;
                                            var unavailable = !string.Equals(offer.Availability, "available", StringComparison.OrdinalIgnoreCase);
                                            var lowStock = !unavailable && offer.LowStock;
                                            var presentation = unavailable ? $"{colorLabel} / {sizeLabel} indisponível" : lowStock ? $"{colorLabel} / {sizeLabel}, últimas unidades" : $"{colorLabel} / {sizeLabel}";
                                            <label class="offer-size-choice@(unavailable ? " is-unavailable" : "")@(lowStock ? " is-low-stock" : "")" aria-label="@presentation">
                                                <input type="radio" name="publicOfferId" value="@offer.PublicOfferId" data-offer-id="@offer.PublicOfferId" data-variant-key="@key" data-price="@(offer.UnitPrice?.ToString(System.Globalization.CultureInfo.InvariantCulture))" data-currency="@offer.Currency" data-availability="@offer.Availability" data-low-stock="@(lowStock ? "true" : null)" checked="@(Model.SelectedOfferId == offer.PublicOfferId && !unavailable ? "checked" : null)" disabled="@(unavailable ? "disabled" : null)" required>
                                                <span>@sizeLabel</span>
                                                @if (lowStock) { <em class="offer-low-stock" aria-hidden="true">Últimas</em> }
                                            </label>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </fieldset>
                    <label class="quantity-label">Quantidade <input type="number" name="quantity" min="1" max="@CartCookieStore.MaxUnitsPerLine" value="@Model.Quantity" aria-describedby="quantity-help"></label>
                    <p id="quantity-help">Escolha de 1 a @CartCookieStore.MaxUnitsPerLine unidades.</p>
                    <p class="live-offer" aria-live="polite">@(!selectedOfferIsAvailable ? "Selecione uma oferta para ver preço e disponibilidade." : $"Oferta selecionada: {Model.SelectedOffer!.ColorLabel ?? "Cor única"} / {Model.SelectedOffer.SizeLabel ?? "Tamanho único"}.{(Model.SelectedOffer.LowStock ? " Últimas unidades!" : "")}")</p>
                    <p id="offer-validation-message" class="offer-validation-message" role="alert" aria-live="assertive" hidden="@(string.IsNullOrWhiteSpace(offerError) ? "hidden" : null)">@offerError</p>
                    <button class="button primary-cta" type="submit" data-cart="add">Adicionar ao carrinho</button>
                </form>
                @if (p.Availability == "available") {
                    <section class="shipping-estimate" data-shipping-estimate aria-labelledby="shipping-estimate-title">
                        <h2 id="shipping-estimate-title">Calcular frete</h2>
                        <form method="post" asp-page-handler="QuoteShipping" asp-route-slug="@p.Slug" class="shipping-estimate-form" data-shipping-estimate-form novalidate>
                            <input type="hidden" name="publicOfferId" value="@Model.SelectedOfferId" data-estimate-offer>
                            <input type="hidden" name="quantity" value="@Model.Quantity" data-estimate-quantity>
                            <label>CEP <input type="text" name="postalCode" inputmode="numeric" autocomplete="postal-code" maxlength="9" placeholder="00000-000" value="@Model.EstimatePostalCode" required></label>
                            <button class="button" type="submit">Calcular</button>
                        </form>
                        <div class="shipping-estimate-result" data-shipping-estimate-result aria-live="polite">
                            @if (Model.ShippingEstimateError is not null) { <p class="validation-error" role="alert">@Model.ShippingEstimateError</p> }
                            @if (Model.ShippingEstimate is { } estimate) {
                                <ul>
                                    @foreach (var option in estimate.Options) {
                                        <li><span><strong>@option.ServiceName</strong> <small>@option.CarrierName · @option.MinimumDeliveryDays a @option.MaximumDeliveryDays dias úteis</small></span>@if (option.FreeShipping) {<em class="free-shipping">Grátis @if (option.RegularPrice is { } regular) {<s>@CurrencyPresentation.Format(regular, estimate.Currency)</s>}</em>} else {<em>@CurrencyPresentation.Format(option.Price, estimate.Currency)</em>}</li>
                                    }
                                </ul>
                                <p class="shipping-estimate-note">Estimativa para esta opção e quantidade. O valor final é confirmado no checkout.</p>
                            }
                        </div>
                    </section>
                }
                @{
                    var soldOut = p.Variants.SelectMany(variant => variant.Offers.Select(offer => (Variant: variant, Offer: offer)))
                        .Where(item => !string.Equals(item.Offer.Availability, "available", StringComparison.OrdinalIgnoreCase))
                        .ToList();
                }
                @if (soldOut.Count > 0) {
                    <details class="stock-alert" id="stock-alert" open="@(Model.StockAlertStatus is null ? null : "open")">
                        <summary>Avise-me quando chegar</summary>
                        @if (Model.StockAlertStatus == "ok") { <p class="stock-alert-message" role="status" data-stock-alert="ok">Pronto! Enviaremos um e-mail quando este tamanho voltar ao estoque.</p> }
                        else if (Model.StockAlertStatus == "available") { <p class="stock-alert-message" role="status" data-stock-alert="available">Esta opção já está disponível. Atualize a página para comprar.</p> }
                        else if (Model.StockAlertStatus == "invalid") { <p class="stock-alert-message is-error" role="alert" data-stock-alert="invalid">Confira o e-mail, a opção escolhida e o aceite da política de privacidade.</p> }
                        else if (Model.StockAlertStatus == "unavailable") { <p class="stock-alert-message is-error" role="alert" data-stock-alert="unavailable">Não foi possível registrar o aviso agora. Tente novamente em instantes.</p> }
                        <form method="post" asp-page-handler="StockAlert" class="stock-alert-form">
                            <label>Opção
                                <select name="alertOfferId" required>
                                    @foreach (var item in soldOut) {
                                        <option value="@item.Offer.PublicOfferId">@(string.IsNullOrWhiteSpace(item.Variant.ColorLabel) ? "Cor única" : item.Variant.ColorLabel) / @(string.IsNullOrWhiteSpace(item.Offer.SizeLabel) ? "Tamanho único" : item.Offer.SizeLabel)</option>
                                    }
                                </select>
                            </label>
                            <label>E-mail <input type="email" name="alertEmail" maxlength="254" autocomplete="email" required></label>
                            <label class="account-check"><input type="checkbox" name="alertConsent" value="true" required><span>Aceito a política de privacidade @if (Model.PrivacyPolicyUrl is not null) { <text>(<a href="@Model.PrivacyPolicyUrl">ler a política</a>)</text> }.</span></label>
                            <button class="button" type="submit">Avisar por e-mail</button>
                        </form>
                    </details>
                }
                @if (StorefrontOptions.Value.PublicAssistantEnabled) { <button class="button" type="button" data-assistant-open data-assistant-product="@p.Slug">Perguntar sobre este produto</button> }
                <noscript><p>Escolha uma oferta para adicionar ao carrinho.</p></noscript>
            </section>
        </div>
        @if (Model.Related.State == CatalogLoadState.Success) { <section class="related-products"><h2>Produtos relacionados</h2><div class="products">@for (var i = 0; i < Model.Related.Products.Count; i++) { <partial name="_ProductCard" model="@(new ProductCardViewModel(Model.Related.Products[i], "related", i))" /> }</div></section> }
        else if (Model.Related.State == CatalogLoadState.Empty) { <p class="related-state">Nenhum produto relacionado no momento.</p> }
        else if (Model.Related.State == CatalogLoadState.Unavailable) { <p class="related-state">Produtos relacionados temporariamente indisponíveis.</p> }
    </main>
}
