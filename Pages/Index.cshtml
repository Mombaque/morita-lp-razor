@page
@model IndexModel
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    var canonicalBase = Configuration["CanonicalBaseUrl"] ?? "https://moritafight.com.br/";
    ViewData["Title"] = "Morita Fight | Equipamentos para artes marciais";
    ViewData["Description"] = "Kimonos, luvas, rashguards, shorts e acessórios para Jiu-Jitsu e Muay Thai, com retirada em Sorocaba.";
    ViewData["OgTitle"] = "Morita Fight | Vista seu próximo round";
    ViewData["OgDescription"] = "Equipamentos selecionados para Jiu-Jitsu, Muay Thai e jovens atletas.";
    ViewData["BodyClass"] = "home-page commerce-page";
}

@section Header {
<script type="application/ld+json">
{
  "@@context": "https://schema.org",
  "@@type": "SportingGoodsStore",
  "name": "Morita Fight",
  "url": "@(canonicalBase)",
  "image": "@($"{canonicalBase.TrimEnd('/')}/images/favicon.png")",
  "telephone": "+55-15-98107-9332",
  "address": {
    "@@type": "PostalAddress",
    "streetAddress": "Rua Coronel Nogueira Padilha, 429",
    "addressLocality": "Sorocaba",
    "addressRegion": "SP",
    "postalCode": "18020-000",
    "addressCountry": "BR"
  }
}
</script>
}

<main class="commerce-shell home-storefront">
  <section class="commerce-hero" aria-labelledby="home-title">
    <div class="commerce-hero-copy">
      <h1 id="home-title">Vista seu<br><span>próximo round.</span></h1>
      <p class="hero-lead">Equipamento de luta escolhido com critério, preço confirmado no catálogo e ajuda humana quando você precisar.</p>
      <div class="hero-actions">
        <a class="commerce-button commerce-button-primary" href="/products">Explorar catálogo <span aria-hidden="true">→</span></a>
      </div>
      <dl class="commerce-promises" aria-label="Benefícios da loja">
        <div><dt>Estoque real</dt><dd>Veja o que está disponível antes de comprar.</dd></div>
        <div><dt>Retire ou receba</dt><dd>Retirada em Sorocaba ou envio para todo o Brasil.</dd></div>
        <div><dt>Ajuda para escolher</dt><dd>Fale com quem conhece os produtos e o treino.</dd></div>
      </dl>
    </div>
  </section>

  <section class="discipline-strip" aria-labelledby="shop-by-discipline">
    <div class="section-heading"><p class="fight-label">Encontre o que procura</p><h2 id="shop-by-discipline">Escolha sua modalidade</h2></div>
    <div class="discipline-grid">
      <a href="/jiu-jitsu"><strong>Jiu-Jitsu</strong><em>Kimonos, rashguards, faixas e acessórios →</em></a>
      <a href="/muay-thai"><strong>Muay Thai</strong><em>Luvas, shorts e proteções →</em></a>
      <a href="/kids"><strong>Kids</strong><em>Equipamentos infantis →</em></a>
    </div>
  </section>

  <section class="featured-catalog" aria-labelledby="featured-title">
    <div class="section-heading section-heading-row">
      <div><p class="fight-label">Seleção Morita</p><h2 id="featured-title">Produtos em destaque</h2></div>
      <a href="/products">Ver catálogo completo →</a>
    </div>
    @if (Model.Catalog.State == CatalogLoadState.Unavailable)
    {
      <div class="catalog-state catalog-unavailable" role="status"><h3>Catálogo temporariamente indisponível</h3><p>Tente novamente em instantes ou fale conosco pelo WhatsApp.</p></div>
    }
    else if (Model.Catalog.State == CatalogLoadState.Empty)
    {
      <div class="catalog-state catalog-empty" role="status"><h3>Novos produtos entrando no corner</h3><p>O catálogo online está sendo atualizado. Enquanto isso, fale com a equipe para consultar o estoque da loja.</p></div>
    }
    else
    {
      @if (Model.Catalog.State == CatalogLoadState.Partial)
      { <div class="catalog-state catalog-partial" role="status"><p>Parte do catálogo está temporariamente indisponível. Os produtos carregados continuam disponíveis.</p></div> }
      <div class="products storefront-products" data-track-category="home-featured">
        @for (var index = 0; index < Model.FeaturedProducts.Count; index++)
        {
          <partial name="_ProductCard" model="@(new ProductCardViewModel(Model.FeaturedProducts[index], "home", index))" />
        }
      </div>
    }
  </section>

  <section class="store-visit" aria-labelledby="visit-title">
    <div class="store-visit-copy">
      <p class="fight-label">Loja física em Sorocaba</p>
      <h2 id="visit-title">Prefere ver de perto?</h2>
      <p class="store-visit-description">Veja os produtos, confira o tamanho e tire suas dúvidas antes de comprar.</p>
      <p class="store-visit-address">Rua Coronel Nogueira Padilha, 429</p>
    </div>
    <div class="hero-actions store-visit-actions">
      <a class="commerce-button commerce-button-primary" href="https://maps.app.goo.gl/pNYYiMimWGa4actz7">Como chegar</a>
      <a class="commerce-button commerce-button-secondary" href="https://wa.me/5515981079332" target="_blank" rel="noopener noreferrer">Falar no WhatsApp</a>
    </div>
  </section>
</main>
