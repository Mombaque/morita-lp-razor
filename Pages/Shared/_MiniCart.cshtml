<div class="mini-cart-backdrop" data-mini-cart-backdrop hidden></div>
<aside class="mini-cart" id="mini-cart" role="dialog" aria-modal="true" aria-labelledby="mini-cart-heading" aria-hidden="true" tabindex="-1" inert data-mini-cart>
    <header class="mini-cart-header">
        <h2 id="mini-cart-heading"><i class="fas fa-check" aria-hidden="true"></i> Adicionado ao carrinho</h2>
        <button type="button" class="mini-cart-close" data-mini-cart-close aria-label="Fechar">×</button>
    </header>
    <div class="mini-cart-item">
        <img src="" alt="" data-mini-cart-image hidden>
        <div>
            <p class="mini-cart-name" data-mini-cart-name></p>
            <p class="mini-cart-variant" data-mini-cart-variant></p>
            <p class="mini-cart-price" data-mini-cart-price></p>
        </div>
    </div>
    <p class="mini-cart-count" data-mini-cart-count></p>
    <div class="mini-cart-actions">
        <a class="commerce-button commerce-button-primary" href="/checkout">Finalizar compra</a>
        <a class="commerce-button commerce-button-secondary" href="/cart">Ver carrinho</a>
        <button type="button" class="mini-cart-continue" data-mini-cart-close>Continuar comprando</button>
    </div>
</aside>
