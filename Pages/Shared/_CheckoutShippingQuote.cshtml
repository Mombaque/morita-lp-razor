@model Morita.LP.Razor.Pages.CheckoutModel

<div data-shipping-quote>
  @if (Model.ErrorMessage is not null)
  {
    <p class="validation-error" data-shipping-quote-error role="alert">@Model.ErrorMessage</p>
  }
  @if (Model.ShippingQuotes.Quote is { } shippingQuote)
  {
    <fieldset class="shipping-options"><legend>Escolha a entrega</legend>
      @foreach (var option in shippingQuote.Options)
      {
        <label><input asp-for="PublicShippingQuoteId" type="radio" value="@option.PublicShippingQuoteId" data-shipping-service="@option.ServiceName" data-shipping-detail="@option.CarrierName · @option.MinimumDeliveryDays a @option.MaximumDeliveryDays dias úteis" data-shipping-price="@CurrencyPresentation.Format(option.Price, shippingQuote.Currency)" data-shipping-amount="@option.Price.ToString(System.Globalization.CultureInfo.InvariantCulture)"><span><strong>@option.ServiceName</strong><small>@option.CarrierName · @option.MinimumDeliveryDays a @option.MaximumDeliveryDays dias úteis</small></span><em>@CurrencyPresentation.Format(option.Price, shippingQuote.Currency)</em></label>
      }
    </fieldset>
    <p class="cart-estimate-note">Cotação válida até <time datetime="@shippingQuote.ExpiresAt.ToString("O")" data-local-time="time">@TimePresentation.ToStoreTime(shippingQuote.ExpiresAt).ToString("HH:mm")</time>. Se expirar, calcule novamente.</p>
  }
  <span asp-validation-for="PublicShippingQuoteId" class="validation-error"></span>
</div>
