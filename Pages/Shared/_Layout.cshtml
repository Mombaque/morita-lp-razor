@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@inject Microsoft.Extensions.Options.IOptions<Morita.LP.Razor.Configuration.CatalogApiOptions> CatalogApiOptions
@inject Microsoft.Extensions.Options.IOptions<Morita.LP.Razor.Configuration.StorefrontOptions> StorefrontOptions
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@inject Morita.LP.Razor.Services.ICustomerAccountCookieStore CustomerAccountCookies
@using System.Text.Json
@{
    var apiBaseUrl = CatalogApiOptions.Value.BaseUrl;
    var canonicalBase = Configuration["CanonicalBaseUrl"] ?? "https://moritafight.com.br/";
    var title = ViewData["Title"] ?? "Morita - Equipamentos para Artes Marciais em Sorocaba";
    var description = ViewData["Description"] ?? "Equipamentos para Jiu-Jitsu e Muay Thai com retirada em Sorocaba e entrega para todo o Brasil.";
    var canonical = ViewData["Canonical"] ?? $"{canonicalBase.TrimEnd('/')}{ViewContext.HttpContext.Request.Path}";
    var hasOgImage = !ViewData.ContainsKey("OgImage") || ViewData["OgImage"] is string;
    var ogImage = ViewData["OgImage"] as string ?? $"{canonicalBase.TrimEnd('/')}/images/favicon.png";
    var robots = ViewData["Robots"] as string ?? "index,follow,max-snippet:-1,max-image-preview:large,max-video-preview:-1";
    var publicAssistantEnabled = StorefrontOptions.Value.PublicAssistantEnabled;
    var customerSignedIn = CustomerAccountCookies.Read() is not null;
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@title</title>
    <meta name="description" content="@description">
    <meta name="robots" content="@robots">
    <link rel="canonical" href="@canonical">
    <link rel="alternate" hreflang="pt-BR" href="@canonical">
    <link rel="icon" href="~/images/favicon.png" type="image/png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:ital,wght@@0,600;0,700;0,800;0,900;1,700&family=IBM+Plex+Sans:wght@@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="~/css/styles.css" asp-append-version="true">
    @if (publicAssistantEnabled) { <link rel="stylesheet" href="~/css/public-assistant.css" asp-append-version="true"> }
    
    <meta property="og:type" content="website">
    <meta property="og:locale" content="pt_BR">
    <meta property="og:title" content="@(ViewData["OgTitle"] ?? "Morita | Artes Marciais em Sorocaba")">
    <meta property="og:description" content="@(ViewData["OgDescription"] ?? "Kimonos, luvas, rashguards, shorts e acessórios para Jiu-Jitsu e Muay Thai em Sorocaba.")">
    <meta property="og:url" content="@canonical">
    @if (hasOgImage) { <meta property="og:image" content="@ogImage"> }
    <meta name="request-verification-token" content="@Antiforgery.GetAndStoreTokens(Context).RequestToken">

    <!-- Google Tag Manager -->
    <script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
      new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
      j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
      'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
      })(window,document,'script','dataLayer','GTM-TK3DKRF9');
    </script>
    <!-- End Google Tag Manager -->
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=AW-17391563568"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'AW-17391563568');
    </script>

    @RenderSection("Header", required: false)
</head>
<body class="@ViewData["BodyClass"]">
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-TK3DKRF9"
      height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->

    @{
        var currentPath = Context.Request.Path.Value?.TrimEnd('/');
        var isHome = string.IsNullOrEmpty(currentPath);
        var isJiuJitsu = currentPath == "/jiu-jitsu";
        var isMuayThai = currentPath == "/muay-thai";
        var isKids = currentPath == "/kids";
        var isProducts = currentPath == "/products" || currentPath?.StartsWith("/products/") == true;
    }
    <header class="commerce-site-header">
        <div class="commerce-nav-row">
            <a class="commerce-logo" href="/" aria-label="Morita Fight - início"><img src="~/images/logo.png" alt="Morita Fight"></a>
            <form class="commerce-search" method="get" action="/products" role="search">
                <label class="visually-hidden" for="site-search">Buscar no catálogo</label>
                <input id="site-search" name="search" type="search" placeholder="Buscar kimono, luva, faixa..." maxlength="100">
                <button type="submit" aria-label="Buscar"><i class="fas fa-magnifying-glass" aria-hidden="true"></i></button>
            </form>
            <div class="commerce-cart">@await Component.InvokeAsync("CartIndicator")</div>
        </div>
        <nav class="main-nav" aria-label="Navegação principal">
            <a href="/" class="nav-link @(isHome ? "active" : "")" aria-current="@(isHome ? "page" : null)">Início</a>
            <a href="/products" class="nav-link @(isProducts ? "active" : "")" aria-current="@(isProducts ? "page" : null)">Todos os produtos</a>
            <a href="/jiu-jitsu" class="nav-link @(isJiuJitsu ? "active" : "")" aria-current="@(isJiuJitsu ? "page" : null)">Jiu-Jitsu</a>
            <a href="/muay-thai" class="nav-link @(isMuayThai ? "active" : "")" aria-current="@(isMuayThai ? "page" : null)">Muay Thai</a>
            <a href="/kids" class="nav-link @(isKids ? "active" : "")" aria-current="@(isKids ? "page" : null)">Kids</a>
            <a href="/conta" class="nav-link nav-account">@(customerSignedIn ? "Minha conta" : "Entrar")</a>
        </nav>
    </header>

    @RenderBody()

    @if (publicAssistantEnabled) { <div id="public-assistant-root"></div> }

    <footer class="commerce-footer">
        <div><img src="~/images/logo.png" alt="Morita Fight"><p>Equipamento para quem leva o treino a sério.</p></div>
        <div><strong>Loja</strong><a href="/products">Catálogo</a><a href="/jiu-jitsu">Jiu-Jitsu</a><a href="/muay-thai">Muay Thai</a><a href="/kids">Kids</a></div>
        <div><strong>Visite</strong><a href="https://maps.app.goo.gl/pNYYiMimWGa4actz7">Rua Coronel Nogueira Padilha, 429<br>Sorocaba, SP</a><a href="https://wa.me/5515981079332">WhatsApp (15) 98107-9332</a></div>
    </footer>

    <script>
        window.API_BASE_URL = @Html.Raw(JsonSerializer.Serialize(apiBaseUrl));
        window.CUSTOMER_REQUEST_RELAY = @Html.Raw(JsonSerializer.Serialize(Configuration.GetValue<bool>("Storefront:UseRelayForCustomerRequests")));
        window.CUSTOMER_REQUEST_RELAY_URL = "/customer-product-request";
    </script>
    <script src="~/js/carousel.js" asp-append-version="true"></script>
    <script type="module" src="~/js/customer-product-request.js" asp-append-version="true"></script>
    @if (publicAssistantEnabled) { <script type="module" src="~/js/public-assistant.js" asp-append-version="true"></script> }
    <script type="module" src="~/js/tracking.js" asp-append-version="true"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
