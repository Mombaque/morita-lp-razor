@model ProductCardViewModel
@{
    var p = Model.Product;
    var cleanName = System.Text.RegularExpressions.Regex.Replace(p.Nome.ToLowerInvariant(), @"[^\w-]", "");
    var carouselId = $"carousel-{cleanName}-{Model.Index}";
    var images = p.Imagens;
    var productUrl = string.IsNullOrWhiteSpace(p.Slug) ? null : $"/products/{Uri.EscapeDataString(p.Slug)}";
}
<div class="product@(productUrl is not null ? " product-clickable" : "")">
  @if (productUrl is not null)
  { <a class="product-card-hit-area" href="@productUrl" aria-label="Ver produto: @p.Nome"></a> }
  <div class="carousel" id="@carouselId">
    @if (images.Count == 0)
    { <div class="product-image-empty" role="img" aria-label="@p.Alt">Imagem indisponível</div> }
    else
    {
      @for (var i = 0; i < images.Count; i++)
      { <img src="@(images[i].StartsWith("/", StringComparison.Ordinal) ? Url.Content("~" + images[i]) : images[i])" alt="@(i == 0 ? p.Alt : "")" class="carousel-img @(i == 0 ? "active" : "")" data-index="@i" loading="@(Model.Index > 3 ? "lazy" : "eager")"> }
    }
    @if (images.Count > 1)
    { <button class="prev" type="button" onclick="getImage('@carouselId', false)" aria-label="Imagem anterior">&#10094;</button><button class="next" type="button" onclick="getImage('@carouselId', true)" aria-label="Próxima imagem">&#10095;</button> }
  </div>
  <div class="product-card-body"><p class="product-taxonomy">@(p.Modality?.Label ?? Model.Category) @if(p.Category is not null){<span>/ @p.Category.Label</span>} @if(p.Audience == PublicCatalogAudience.Kids){<span>/ Infantil</span>}</p><h3>@p.Nome</h3><p class="product-description">@p.Descricao</p>
  @if (!string.IsNullOrWhiteSpace(p.FormattedPrice))
  { <partial name="_ProductPrice" model="p.FormattedPrice" /> }
  @if (productUrl is null) { <button class="product-cta" type="button" aria-label="Consultar disponibilidade de @p.Nome" data-request-open data-track-event="customer_product_request_open" data-track-category="@Model.Category" data-track-selected-category="@p.Nome"><i class="fas fa-magnifying-glass"></i> Consultar disponibilidade</button> } else { <div class="product-card-footer"><span class="product-cta">Ver produto</span><span class="product-availability">@(p.Availability == "available" ? "Em estoque" : "Indisponível")</span></div> }</div>
</div>
