@model Morita.LP.Razor.Pages.AccountModel
<form method="post" asp-page-handler="SaveAddress" class="address-form">
    <input type="hidden" asp-for="AddressId">
    <fieldset data-address-cep-auto>
        <legend>Dados completos do endereço</legend>
        <label asp-for="AddressLabel">Rótulo</label>
        <input asp-for="AddressLabel" placeholder="Casa" maxlength="80">
        <span asp-validation-for="AddressLabel" class="validation-error"></span>
        <label asp-for="AddressForm.Recipient">Destinatário</label>
        <input asp-for="AddressForm.Recipient" autocomplete="name">
        <span asp-validation-for="AddressForm.Recipient" class="validation-error"></span>
        <label asp-for="AddressForm.PostalCode">CEP</label>
        <input asp-for="AddressForm.PostalCode" autocomplete="postal-code" inputmode="numeric" placeholder="00000-000" maxlength="9" data-cep-input>
        <p class="cep-lookup-status" role="status" aria-live="polite"><span data-cep-message></span> <a href="https://buscacepinter.correios.com.br/app/endereco/index.php" target="_blank" rel="noopener">Não sei meu CEP</a></p>
        <span asp-validation-for="AddressForm.PostalCode" class="validation-error"></span>
        <div class="address-details" data-address-details>
            <label asp-for="AddressForm.Street">Rua</label>
            <input asp-for="AddressForm.Street" autocomplete="address-line1" data-address-field="street">
            <span asp-validation-for="AddressForm.Street" class="validation-error"></span>
            <label asp-for="AddressForm.Number">Número</label>
            <input asp-for="AddressForm.Number" data-address-field="number">
            <span asp-validation-for="AddressForm.Number" class="validation-error"></span>
            <label asp-for="AddressForm.Complement">Complemento (opcional)</label>
            <input asp-for="AddressForm.Complement">
            <label asp-for="AddressForm.Neighborhood">Bairro</label>
            <input asp-for="AddressForm.Neighborhood" data-address-field="neighborhood">
            <span asp-validation-for="AddressForm.Neighborhood" class="validation-error"></span>
            <label asp-for="AddressForm.City">Cidade</label>
            <input asp-for="AddressForm.City" autocomplete="address-level2" data-address-field="city">
            <span asp-validation-for="AddressForm.City" class="validation-error"></span>
            <label asp-for="AddressForm.State">UF</label>
            <select asp-for="AddressForm.State" autocomplete="address-level1" data-address-field="state">
                <option value="">Selecione uma UF</option>
                @foreach (var state in AccountModel.BrazilianStates)
                {
                    <option value="@state.Code" selected="@(string.Equals(Model.AddressForm.State, state.Code, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">@state.Name (@state.Code)</option>
                }
            </select>
            <span asp-validation-for="AddressForm.State" class="validation-error"></span>
        </div>
    </fieldset>
    <div class="address-actions">
        <button class="commerce-button commerce-button-primary" type="submit">@(Model.IsEditingAddress ? "Atualizar endereço" : "Salvar endereço")</button>
        @if (Model.IsEditingAddress)
        {
            <a class="commerce-button commerce-button-secondary" href="/conta#enderecos">Cancelar</a>
        }
    </div>
</form>
