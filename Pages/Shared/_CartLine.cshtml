@model CatalogQuoteLine
@{
    var status = Model.Availability?.ToLowerInvariant();
    var available = status == "available";
    var statusMessage = status switch
    {
        "insufficient" => "Quantidade indisponível",
        "inactive" => "Oferta inativa",
        "removed" => "Oferta removida",
        _ => "Oferta indisponível"
    };
    var colorSize = string.Join(" / ", new[] { Model.ColorLabel, Model.SizeLabel }.Where(x => !string.IsNullOrWhiteSpace(x)));
}
<article class="cart-line @(available ? "" : "cart-line-unavailable")" data-cart="line" data-offer-id="@Model.PublicOfferId">
    @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
    {
        <img src="@Model.ImageUrl" alt="@(Model.Presentation ?? "Item do catálogo")" loading="lazy">
    }
    <div class="cart-line-content">
        <h2>@(Model.Presentation ?? "Item do catálogo")</h2>
        @if (!string.IsNullOrWhiteSpace(colorSize))
        {
            <p class="cart-line-variant">@colorSize</p>
        }
        @if (available || status == "insufficient")
        {
            <p class="cart-line-price">Preço atual estimado: <strong>@Model.Currency @Model.UnitPrice?.ToString("0.00")</strong> / unidade</p>
        }
        @if (!available)
        {
            <p class="cart-line-status" role="alert">@statusMessage</p>
        }
        @if (available)
        {
            <form class="cart-quantity-form" method="post" asp-page-handler="Update">
                <input type="hidden" name="publicOfferId" value="@Model.PublicOfferId">
                <label class="cart-quantity-label" for="quantity-@Model.PublicOfferId">Quantidade</label>
                <div class="cart-quantity-stepper" data-cart="quantity-stepper">
                    <button class="cart-quantity-button" type="button" data-cart="quantity-decrement" aria-label="Diminuir quantidade" aria-controls="quantity-@Model.PublicOfferId">−</button>
                    <input class="cart-quantity-input" id="quantity-@Model.PublicOfferId" type="number" name="quantity" min="1" max="10" value="@Model.Quantity" inputmode="numeric" data-cart="quantity-input">
                    <button class="cart-quantity-button" type="button" data-cart="quantity-increment" aria-label="Aumentar quantidade" aria-controls="quantity-@Model.PublicOfferId">+</button>
                </div>
                <button class="button cart-button-primary" type="submit" data-cart="update">Atualizar</button>
            </form>
        }
        <form class="cart-remove-form" method="post" asp-page-handler="Remove">
            <input type="hidden" name="publicOfferId" value="@Model.PublicOfferId">
            <button class="button cart-button-danger" type="submit" data-cart="remove">Remover item</button>
        </form>
    </div>
</article>
