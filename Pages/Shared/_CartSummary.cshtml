@model CatalogQuoteResult
<h2>Resumo</h2>
<p data-cart="total">Total estimado: <strong>@Model.Currency @Model.Total?.ToString("0.00")</strong></p>
<p class="cart-estimate-note">Os preços atuais são estimativas e podem mudar.</p>
@if (Model.State == CatalogLoadState.Success)
{
    <a class="button primary-cta" href="/checkout" data-cart="checkout">Reservar para retirada</a>
}
else
{
    <button class="button primary-cta" type="button" disabled data-cart="checkout" aria-disabled="true">Reservar para retirada</button>
}
<form method="post" asp-page-handler="Clear">
    <button class="button" type="submit" data-cart="clear">Limpar carrinho</button>
</form>
