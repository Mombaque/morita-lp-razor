@model CatalogQuoteResult
<h2>Resumo</h2>
@if (Model.State == CatalogLoadState.Success)
{
    <p data-cart="total">Subtotal: <strong>@CurrencyPresentation.Format(Model.Total, Model.Currency)</strong></p>
    <p class="cart-estimate-note">Frete calculado pelo CEP no checkout.</p>
}
else
{
    <p class="cart-estimate-note" data-cart="correction">Revise os itens marcados como indisponíveis e reduza a quantidade ou remova-os para continuar. O total será recalculado após a correção.</p>
}
@if (Model.State == CatalogLoadState.Success)
{
    <a class="button cart-button-primary" href="/checkout" data-cart="checkout">Ir para o checkout</a>
}
else
{
    <button class="button cart-button-primary" type="button" disabled data-cart="checkout" aria-disabled="true">Ir para o checkout</button>
}
<form method="post" asp-page-handler="Clear" data-confirm="Remover todos os itens do carrinho?">
    <button class="button cart-button-secondary" type="submit" data-cart="clear">Limpar carrinho</button>
</form>
