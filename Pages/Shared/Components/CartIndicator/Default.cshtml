@model Morita.LP.Razor.ViewComponents.CartIndicatorModel
<a href="/cart" class="nav-link cart-indicator" data-cart="indicator" aria-label="Carrinho, @Model.Count @(Model.Count == 1 ? "item" : "itens")"><i class="fas fa-bag-shopping" aria-hidden="true"></i> Carrinho <span data-cart="count">@Model.Count</span></a>
