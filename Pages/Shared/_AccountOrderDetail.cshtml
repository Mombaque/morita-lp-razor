@model Morita.LP.Razor.Models.PublicOrder
<section class="account-panel order-detail" aria-labelledby="selected-order-heading">
    <h2 id="selected-order-heading">Detalhes do pedido @Model.PublicOrderNumber</h2>
    <p>Pagamento: <strong class="@AccountPresentation.PaymentStatusClass(Model.PaymentStatus)">@AccountPresentation.PaymentStatus(Model.PaymentStatus)</strong></p>
    <p>Status: <strong>@AccountPresentation.FulfillmentStatus(AccountPresentation.EffectiveFulfillmentStatus(Model))</strong> · @AccountPresentation.FulfillmentMethod(Model.FulfillmentMethod)</p>
    @{ var timeline = OrderTimeline.Build(Model); }
    @if (timeline.Count > 0)
    {
        <ol class="order-timeline" data-order-timeline aria-label="Andamento do pedido">
            @foreach (var step in timeline)
            {
                <li class="order-timeline-step is-@step.State.ToString().ToLowerInvariant()" data-step-state="@step.State.ToString().ToLowerInvariant()" aria-current="@(step.State == OrderTimelineStepState.Current ? "step" : null)">
                    <span class="order-timeline-label">@step.Label</span>
                    @if (step.At is { } at)
                    {
                        <time datetime="@at.ToString("O")">@TimePresentation.ToStoreTime(at).ToString("dd/MM HH:mm")</time>
                    }
                </li>
            }
        </ol>
        @if (OrderTimeline.HasException(Model))
        {
            <p class="order-timeline-alert" data-order-timeline-alert>A transportadora registrou uma ocorrência. Estamos verificando e avisaremos por e-mail.</p>
        }
    }
    <ul>
        @foreach (var line in Model.Lines)
        {
            <li><strong>@line.Presentation</strong> — @line.Quantity × @CurrencyPresentation.Format(line.UnitPrice, Model.Currency) = @CurrencyPresentation.Format(line.Total, Model.Currency)</li>
        }
    </ul>
    @if (Model.Invoice is { Number: not null } invoice)
    {
        var fromAccount = ViewData["InvoiceFromAccount"] is true;
        string InvoiceUrl(string kind) => fromAccount
            ? $"/conta?handler=Invoice&number={Uri.EscapeDataString(Model.PublicOrderNumber)}&kind={kind}"
            : $"/order/{Uri.EscapeDataString(Model.PublicOrderNumber)}?handler=Invoice&kind={kind}";
        <div class="order-invoice" data-order-invoice>
            <h3>Nota fiscal</h3>
            <p>NF-e nº @invoice.Number@(invoice.Series is { } series ? $" · série {series}" : "")@if (invoice.AuthorizedAt is { } issuedAt) {<text> · emitida em <time datetime="@issuedAt.ToString("O")">@TimePresentation.ToStoreTime(issuedAt).ToString("dd/MM/yyyy")</time></text>}</p>
            @if (invoice.Cancelled)
            {
                <p data-order-invoice-cancelled>Esta nota fiscal foi cancelada.</p>
            }
            else
            {
                <p class="order-invoice-links">
                    @if (invoice.HasFile(PublicOrderInvoice.Danfe)) { <a class="commerce-button" href="@InvoiceUrl(PublicOrderInvoice.Danfe)" data-invoice-file="danfe">Baixar DANFE (PDF)</a> }
                    @if (invoice.HasFile(PublicOrderInvoice.Xml)) { <a class="commerce-button" href="@InvoiceUrl(PublicOrderInvoice.Xml)" data-invoice-file="xml">Baixar XML</a> }
                </p>
            }
        </div>
    }
    @if (Model.Shipping is { } shipping)
    {
        <p>Frete: <strong>@CurrencyPresentation.Format(shipping.Price, Model.Currency)</strong></p>
        <h3>Endereço de entrega</h3>
        <p>@shipping.Address.Recipient<br>@shipping.Address.Street, @shipping.Address.Number @shipping.Address.Complement<br>@shipping.Address.Neighborhood · @shipping.Address.City/@shipping.Address.State · CEP @shipping.Address.PostalCode</p>
    }
    @if (Model.FulfillmentMethod == "pickup" && Model.HasPickupCode)
    {
        <div class="pickup-code" data-pickup-code>
            <p>Seu pedido está pronto para retirada. Informe este código na loja:</p>
            <p class="pickup-code-value" aria-label="Código de retirada">@Model.PickupCode</p>
        </div>
    }
    @if (Model.FulfillmentMethod == "pickup" && Model.PickupAddress is { } pickup)
    {
        <h3>Retirada</h3>
        <p><strong>@Model.PickupDisplayName</strong><br>@pickup.Street, @pickup.Number - @pickup.Neighborhood, @pickup.City/@pickup.State</p>
        <p>@Model.PickupHours</p>
        @if (!string.IsNullOrWhiteSpace(Model.PickupInstructions))
        {
            <p>@Model.PickupInstructions</p>
        }
    }
    @if (Model.Shipment is { } shipment)
    {
        <h3>Envio</h3>
        <p>@AccountPresentation.FulfillmentStatus(shipment.Status) · @shipment.CarrierName @shipment.ServiceName</p>
        @if (!string.IsNullOrWhiteSpace(shipment.TrackingCode))
        {
            <div class="order-tracking" data-order-tracking>
                <p>Código de rastreamento: <strong data-tracking-code>@shipment.TrackingCode</strong></p>
                <p class="order-tracking-actions">
                    <button type="button" class="commerce-button" data-copy-text="@shipment.TrackingCode">Copiar código</button>
                    <a class="commerce-button" href="@OrderTimeline.TrackingSiteUrl" target="_blank" rel="noopener noreferrer">Rastrear no Melhor Rastreio</a>
                </p>
            </div>
        }
        <p>Atualizado em <time datetime="@shipment.UpdatedAt.ToString("O")">@TimePresentation.ToStoreTime(shipment.UpdatedAt).ToString("dd/MM/yyyy HH:mm")</time>.</p>
        @if (shipment.ShippedAt is { } shippedAt)
        {
            <p>Enviado em <time datetime="@shippedAt.ToString("O")">@TimePresentation.ToStoreTime(shippedAt).ToString("dd/MM/yyyy HH:mm")</time>.</p>
        }
        @if (shipment.DeliveredAt is { } deliveredAt)
        {
            <p>Entregue em <time datetime="@deliveredAt.ToString("O")">@TimePresentation.ToStoreTime(deliveredAt).ToString("dd/MM/yyyy HH:mm")</time>.</p>
        }
    }
    <p>Pedido criado em <time datetime="@Model.CreatedAt.ToString("O")">@TimePresentation.ToStoreTime(Model.CreatedAt).ToString("dd/MM/yyyy HH:mm")</time>.</p>
    @if (Model.FulfillmentUpdatedAt is { } updatedAt)
    {
        <p>Entrega atualizada em <time datetime="@updatedAt.ToString("O")">@TimePresentation.ToStoreTime(updatedAt).ToString("dd/MM/yyyy HH:mm")</time>.</p>
    }
    <p><strong>Total: @CurrencyPresentation.Format(Model.Amount, Model.Currency)</strong></p>
    @if ((Model.LatestProblem ?? Model.OpenProblem) is { } problem)
    {
        <div class="order-problem" data-order-problem="@problem.Status">
            <h3>@(problem.Status == "Resolved" ? "Solicitação respondida" : "Solicitação enviada")</h3>
            <p><strong>@AccountPresentation.ProblemReason(problem.Reason)</strong></p>
            @if (problem.Items.Count > 0)
            {
                <ul>@foreach (var item in problem.Items) { <li>@item.Quantity × @item.Description</li> }</ul>
            }
            <p>@problem.Message</p>
            <p>Enviada em <time datetime="@problem.CreatedAt.ToString("O")">@TimePresentation.ToStoreTime(problem.CreatedAt).ToString("dd/MM/yyyy HH:mm")</time>.</p>
            @if (problem.Status == "Resolved")
            {
                @if (!string.IsNullOrWhiteSpace(problem.StaffNote)) { <p class="order-problem-answer" data-order-problem-answer><strong>Resposta da loja:</strong> @problem.StaffNote</p> }
                else { <p>A loja concluiu o atendimento.</p> }
            }
            else
            {
                <p>A loja vai analisar e responder por e-mail.</p>
            }
        </div>
    }
    @if (Model.CanReportProblem)
    {
        var returnsOpen = Model.ReturnWindowEndsAt is { } endsAt && endsAt >= DateTimeOffset.UtcNow;
        var draft = ViewData["ProblemDraft"] as OrderProblemDraft;
        <h3>Trocas, devoluções e problemas</h3>
        @if (Model.ReturnWindowEndsAt is { } windowEndsAt)
        {
            <p data-return-window>@(returnsOpen ? "Trocas e devoluções podem ser pedidas até" : "O prazo para trocas e devoluções terminou em") <time datetime="@windowEndsAt.ToString("O")">@TimePresentation.ToStoreTime(windowEndsAt).ToString("dd/MM/yyyy")</time>.</p>
        }
        else
        {
            <p data-return-window>Trocas e devoluções ficam disponíveis por 7 dias após a entrega ou retirada.</p>
        }
        <form method="post" class="order-problem-form" action="/conta?handler=ReportProblem&amp;publicOrderNumber=@Uri.EscapeDataString(Model.PublicOrderNumber)#pedidos">
            <label for="problemReason">Motivo</label>
            <select id="problemReason" name="ProblemReason" required>
                <option value="">Selecione</option>
                @if (returnsOpen)
                {
                    <option value="Exchange" selected="@(draft?.Reason == "Exchange")">Quero trocar</option>
                    <option value="Return" selected="@(draft?.Reason == "Return")">Quero devolver</option>
                }
                <option value="Damaged" selected="@(draft?.Reason == "Damaged")">Item danificado</option>
                <option value="Other" selected="@(draft?.Reason == "Other")">Outro</option>
            </select>
            <fieldset class="order-problem-items">
                <legend>Peças (troca, devolução ou dano)</legend>
                @for (var index = 0; index < Model.Lines.Count; index++)
                {
                    var line = Model.Lines[index];
                    <label>@(string.IsNullOrWhiteSpace(line.Presentation) ? line.Description : line.Presentation)
                        <input type="number" name="ProblemQuantities[@index]" min="0" max="@line.Quantity" value="@(draft?.Quantities.ElementAtOrDefault(index) ?? 0)" inputmode="numeric" data-problem-line="@index">
                    </label>
                }
            </fieldset>
            <label for="problemMessage">Mensagem</label>
            <textarea id="problemMessage" name="ProblemMessage" maxlength="1000" required placeholder="Ex.: ficou pequeno, quero o tamanho A3.">@draft?.Message</textarea>
            @Html.AntiForgeryToken()
            <button type="submit" class="button">Enviar solicitação</button>
        </form>
    }
</section>
