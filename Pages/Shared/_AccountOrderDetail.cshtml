@model Morita.LP.Razor.Models.PublicOrder
<section class="account-panel order-detail" aria-labelledby="selected-order-heading">
    <h2 id="selected-order-heading">Detalhes do pedido @Model.PublicOrderNumber</h2>
    <p>Pagamento: <strong class="@AccountPresentation.PaymentStatusClass(Model.PaymentStatus)">@AccountPresentation.PaymentStatus(Model.PaymentStatus)</strong></p>
    <p>Status: <strong>@AccountPresentation.FulfillmentStatus(Model.FulfillmentStatus)</strong> · @AccountPresentation.FulfillmentMethod(Model.FulfillmentMethod)</p>
    <ul>
        @foreach (var line in Model.Lines)
        {
            <li><strong>@line.Presentation</strong> — @line.Quantity × @CurrencyPresentation.Format(line.UnitPrice, Model.Currency) = @CurrencyPresentation.Format(line.Total, Model.Currency)</li>
        }
    </ul>
    @if (Model.Shipping is { } shipping)
    {
        <p>Frete: <strong>@CurrencyPresentation.Format(shipping.Price, Model.Currency)</strong></p>
        <h3>Endereço de entrega</h3>
        <p>@shipping.Address.Recipient<br>@shipping.Address.Street, @shipping.Address.Number @shipping.Address.Complement<br>@shipping.Address.Neighborhood · @shipping.Address.City/@shipping.Address.State · CEP @shipping.Address.PostalCode</p>
    }
    @if (Model.FulfillmentMethod == "pickup" && Model.PickupAddress is { } pickup)
    {
        <h3>Retirada</h3>
        <p><strong>@Model.PickupDisplayName</strong><br>@pickup.Street, @pickup.Number - @pickup.Neighborhood, @pickup.City/@pickup.State</p>
        <p>@Model.PickupHours</p>
        @if (!string.IsNullOrWhiteSpace(Model.PickupInstructions))
        {
            <p>@Model.PickupInstructions</p>
        }
    }
    @if (Model.Shipment is { } shipment)
    {
        <h3>Envio</h3>
        <p>@AccountPresentation.FulfillmentStatus(shipment.Status) · @shipment.CarrierName @shipment.ServiceName</p>
        @if (!string.IsNullOrWhiteSpace(shipment.TrackingCode))
        {
            <p>Rastreamento: <strong>@shipment.TrackingCode</strong></p>
        }
        <p>Atualizado em <time datetime="@shipment.UpdatedAt.ToString("O")">@TimePresentation.ToStoreTime(shipment.UpdatedAt).ToString("dd/MM/yyyy HH:mm")</time>.</p>
        @if (shipment.ShippedAt is { } shippedAt)
        {
            <p>Enviado em <time datetime="@shippedAt.ToString("O")">@TimePresentation.ToStoreTime(shippedAt).ToString("dd/MM/yyyy HH:mm")</time>.</p>
        }
        @if (shipment.DeliveredAt is { } deliveredAt)
        {
            <p>Entregue em <time datetime="@deliveredAt.ToString("O")">@TimePresentation.ToStoreTime(deliveredAt).ToString("dd/MM/yyyy HH:mm")</time>.</p>
        }
    }
    <p>Pedido criado em <time datetime="@Model.CreatedAt.ToString("O")">@TimePresentation.ToStoreTime(Model.CreatedAt).ToString("dd/MM/yyyy HH:mm")</time>.</p>
    @if (Model.FulfillmentUpdatedAt is { } updatedAt)
    {
        <p>Entrega atualizada em <time datetime="@updatedAt.ToString("O")">@TimePresentation.ToStoreTime(updatedAt).ToString("dd/MM/yyyy HH:mm")</time>.</p>
    }
    <p><strong>Total: @CurrencyPresentation.Format(Model.Amount, Model.Currency)</strong></p>
    @if (Model.OpenProblem is { } problem)
    {
        <h3>Relato enviado</h3>
        <p><strong>@AccountPresentation.ProblemReason(problem.Reason)</strong></p>
        <p>@problem.Message</p>
        <p>Enviado em <time datetime="@problem.CreatedAt.ToString("O")">@TimePresentation.ToStoreTime(problem.CreatedAt).ToString("dd/MM/yyyy HH:mm")</time>.</p>
    }
    else if (Model.CanReportProblem)
    {
        <h3>Informar um problema</h3>
        <form method="post" action="/conta?handler=ReportProblem&amp;publicOrderNumber=@Uri.EscapeDataString(Model.PublicOrderNumber)#pedidos">
            <label for="problemReason">Motivo</label>
            <select id="problemReason" name="ProblemReason" required>
                <option value="">Selecione</option>
                <option value="Damaged">Item danificado</option>
                <option value="Exchange">Quero trocar</option>
                <option value="Other">Outro</option>
            </select>
            <label for="problemMessage">Mensagem</label>
            <textarea id="problemMessage" name="ProblemMessage" maxlength="1000" required></textarea>
            @Html.AntiForgeryToken()
            <button type="submit" class="button">Enviar relato</button>
        </form>
    }
</section>
