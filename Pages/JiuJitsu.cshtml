@page "/jiu-jitsu"
@model JiuJitsuModel
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    var canonicalBase = Configuration["CanonicalBaseUrl"] ?? "https://moritafight.com.br/";
    ViewData["Title"] = "Kimonos, rashguards e faixas de Jiu-Jitsu | Morita Fight";
    ViewData["Description"] = "Equipamentos de Jiu-Jitsu para treino e competição. Consulte cores, tamanhos e estoque na Morita Fight.";
    ViewData["Canonical"] = $"{canonicalBase.TrimEnd('/')}/jiu-jitsu";
    ViewData["Robots"] = string.IsNullOrWhiteSpace(Model.Category) ? "index,follow" : "noindex,follow";
    ViewData["BodyClass"] = "collection-page commerce-page";
}

<main class="commerce-shell collection-shell">
  <section class="collection-hero" aria-labelledby="collection-title">
    <div>
      <p class="fight-label">Grappling / Arte suave</p>
      <h1 id="collection-title">Jiu-<span>Jitsu</span></h1>
      <p>Kimonos, rashguards e faixas para quem começa, evolui e compete. Escolha pelo estoque real e confirme a combinação exata antes de comprar.</p>
      <a class="commerce-button commerce-button-primary" href="#catalog">Ver produtos ↓</a>
    </div>
  </section>

  <nav class="collection-filters" aria-label="Categorias de Jiu-Jitsu">
    <a class="@(Model.Category is null ? "active" : "")" href="/jiu-jitsu">Todos</a>
    @foreach (var category in Model.Filters.Categories)
    {
      <a class="@(Model.Category == category.Slug ? "active" : "")" href="/jiu-jitsu?category=@Uri.EscapeDataString(category.Slug ?? "")">@category.Label</a>
    }
  </nav>

  <section id="catalog" class="collection-catalog" aria-labelledby="catalog-title">
    <div class="section-heading section-heading-row"><div><p class="fight-label">Estoque online</p><h2 id="catalog-title">@(Model.Category is null ? "Todo o Jiu-Jitsu" : Model.Filters.Categories.FirstOrDefault(x => x.Slug == Model.Category)?.Label ?? "Produtos")</h2></div><span>@Model.Catalog.TotalCount produto(s)</span></div>
    @if (Model.Catalog.State == CatalogLoadState.Unavailable)
    { <div class="catalog-state catalog-unavailable" role="status"><h3>Catálogo temporariamente indisponível</h3><p>Tente novamente em instantes.</p></div> }
    else if (Model.Catalog.State == CatalogLoadState.Empty)
    { <div class="catalog-state catalog-empty" role="status"><h3>Nenhum produto encontrado</h3><p>Esta seleção ainda não tem itens publicados. Veja todo o Jiu-Jitsu ou fale com a equipe.</p></div> }
    else
    { <div class="products storefront-products">@for (var index = 0; index < Model.Catalog.Items.Count; index++) { <partial name="_ProductCard" model="@(new ProductCardViewModel(Model.Catalog.Items[index], "jiu-jitsu", index))" /> }</div> }
  </section>
</main>

@section Scripts { <script src="~/js/carousel.js" asp-append-version="true"></script> }
