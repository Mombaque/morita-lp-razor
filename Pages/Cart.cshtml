@page "/cart"
@model CartModel
@{
    ViewData["Title"] = "Carrinho | Morita Fight";
    ViewData["Robots"] = "noindex,nofollow";
}
<main class="cart-shell" data-cart="page">
    <h1>Seu carrinho</h1>
    @if (!string.IsNullOrWhiteSpace(Model.MutationMessage))
    {
        <p class="validation-error" data-cart="message" role="alert">@Model.MutationMessage</p>
    }
    @if (Model.IsEmpty)
    {
        <div class="catalog-state" data-cart="empty">
            <p>Seu carrinho está vazio.</p>
            <a class="button cart-button-primary" href="/products">Ver produtos</a>
        </div>
    }
    else if (Model.Quote.State == CatalogLoadState.Unavailable)
    {
        <div class="catalog-state catalog-unavailable" data-cart="unavailable" role="alert" aria-live="polite">
            <h2>Não foi possível consultar o carrinho</h2>
            <p>Seus itens foram preservados. Tente novamente em instantes.</p>
            <a class="button cart-button-secondary" href="/cart">Tentar novamente</a>
        </div>
    }
    else
    {
        <p class="cart-actions"><a class="button cart-button-secondary" href="/products" data-cart="continue-shopping">Continuar comprando</a></p>
        <div class="cart-layout">
            <section class="cart-lines" aria-label="Itens do carrinho">
                @foreach (var line in Model.Quote.Lines)
                {
                    <partial name="_CartLine" model="line" />
                }
            </section>
            <aside class="cart-summary" aria-label="Resumo do carrinho">
                @if (Model.FreeShippingMinimumAmount is { } freeShippingMinimum && Model.Quote.Total is { } cartTotal)
                {
                    var missing = freeShippingMinimum - cartTotal;
                    <div class="free-shipping-progress@(missing <= 0 ? " is-reached" : "")" data-free-shipping-progress>
                        <p>@(missing <= 0 ? "Você ganhou frete grátis na opção de envio mais econômica." : $"Faltam {CurrencyPresentation.Format(missing, Model.Quote.Currency)} para frete grátis.")</p>
                        <progress max="@freeShippingMinimum.ToString(System.Globalization.CultureInfo.InvariantCulture)" value="@Math.Min(cartTotal, freeShippingMinimum).ToString(System.Globalization.CultureInfo.InvariantCulture)" aria-label="Progresso para frete grátis"></progress>
                    </div>
                }
                <partial name="_CartSummary" model="Model.Quote" />
            </aside>
        </div>
    }
</main>

@section Scripts {
    <script src="~/js/cart.js" asp-append-version="true"></script>
}
