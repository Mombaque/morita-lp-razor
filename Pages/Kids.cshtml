@page "/kids"
@model KidsModel
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    var canonicalBase = Configuration["CanonicalBaseUrl"] ?? "https://moritafight.com.br/";
    ViewData["Title"] = "Equipamentos infantis para artes marciais | Morita Fight";
    ViewData["Description"] = "Kimonos, faixas e equipamentos infantis para jovens atletas, com tamanhos e estoque confirmados.";
    ViewData["Canonical"] = $"{canonicalBase.TrimEnd('/')}/kids";
    ViewData["Robots"] = string.IsNullOrWhiteSpace(Model.Modality) && string.IsNullOrWhiteSpace(Model.Category) && !Model.BrandId.HasValue && Model.Sort == "featured" ? "index,follow" : "noindex,follow";
    ViewData["BodyClass"] = "collection-page commerce-page kids-page";
}

<main class="commerce-shell collection-shell">
  <partial name="_CatalogSection" model="Model.Section" />
</main>

@section Scripts {
  <script type="module" src="~/js/catalog-filters.js" asp-append-version="true"></script>
}
